# MrChromebox fizz board config (configs/kbl/config.fizz.uefi) with the
# edk2 payload replaced by LinuxBoot (Linux kernel + u-root initramfs).
# Covers all fizz variants: SION (Acer CXI3), TEEMO (ASUS CN65),
# WUKONG (CTL CBx1), KENCH (HP G2), JAX (AOpen Commercial 2).
CONFIG_VENDOR_GOOGLE=y
CONFIG_INCLUDE_NHLT_BLOBS=y
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/fizz/flashdescriptor.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/fizz/me.bin"
CONFIG_BOARD_GOOGLE_FIZZ=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_EC_GOOGLE_CHROMEEC_FIRMWARE_EXTERNAL=y
CONFIG_EC_GOOGLE_CHROMEEC_FIRMWARE_FILE="3rdparty/blobs/mainboard/google/fizz/ec.RW.bin"
CONFIG_HAVE_ME_BIN=y
CONFIG_DO_NOT_TOUCH_DESCRIPTOR_REGION=y

# Graphics: edk2 builds rely on Intel's GOP driver inside the payload.
# LinuxBoot has no UEFI, so use coreboot's native libgfxinit to set up a
# linear framebuffer. The kernel picks it up via the coreboot table
# (simpledrm) and i915 takes over once it probes.
CONFIG_MAINBOARD_USE_LIBGFXINIT=y
CONFIG_GENERIC_LINEAR_FRAMEBUFFER=y

# Payload: LinuxBoot
CONFIG_PAYLOAD_LINUXBOOT=y
CONFIG_LINUXBOOT_X86_64=y
# CONFIG_LINUXBOOT_COMPILE_KERNEL is not set
CONFIG_LINUXBOOT_KERNEL_PATH="@PAYLOAD_DIR@/bzImage"
# CONFIG_LINUXBOOT_BUILD_INITRAMFS is not set
CONFIG_LINUXBOOT_INITRAMFS_PATH="@PAYLOAD_DIR@/initramfs.cpio.xz"
CONFIG_LINUXBOOT_INITRAMFS_COMPRESSION_NONE=y
CONFIG_LINUX_COMMAND_LINE="console=tty0 loglevel=4 i915.fastboot=1"
