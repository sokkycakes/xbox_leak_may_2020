+	select SOC_AMD_CYAN_SKILLFISH
+	select BOARD_ROMSIZE_KB_16384
+	select AMD_SOC_CONSOLE_UART
+
+config MAINBOARD_DIR
+	default "asrock/bc250"
+
+config MAINBOARD_PART_NUMBER
+	default "BC-250"
+
+config FMDFILE
+	default "src/mainboard/asrock/bc250/board.fmd"
+
+config CBFS_SIZE
+	default 0xfef000
+
+config UART_FOR_CONSOLE
+	int "FCH UART used for the coreboot console (0-3)"
+	default 0
+	help
+	  Which FCH UART to use. Where (or whether) the BC-250 brings any of
+	  them out to a header or test pads is still unknown; finding it is
+	  part of the bring-up.
+
+choice
+	prompt "Proof-of-life behaviour"
+	default BC250_PROOF_OF_LIFE_HALT
+	help
+	  Silicon init after memory training is not written yet, so a full
+	  boot cannot work. These options decide what the bootblock does once
+	  it has shown that the PSP handed control to coreboot.
+
+config BC250_PROOF_OF_LIFE_HALT
+	bool "Print to serial, then halt"
+
+config BC250_PROOF_OF_LIFE_RESET_LOOP
+	bool "Print to serial, then reset every few seconds"
+	help
+	  For boards with no serial console yet: a coreboot image that runs
+	  makes the board power-cycle on a fixed rhythm (fans spin up again
