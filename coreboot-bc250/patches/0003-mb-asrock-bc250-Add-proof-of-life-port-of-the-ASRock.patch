+	default "asrock/bc250"
+
+config MAINBOARD_PART_NUMBER
+	default "BC-250"
+
+config FMDFILE
+	default "src/mainboard/asrock/bc250/board.fmd"
+
+config CBFS_SIZE
+	default 0xfef000
+
+choice
+	prompt "Serial console"
+	default BC250_CONSOLE_SIO_COM1
+
+config BC250_CONSOLE_SIO_COM1
+	bool "Super I/O COM1 (0x3F8)"
+	help
+	  The stock BIOS's DSDT declares a 16550 COM port (UAR1) at 0x3F8,
+	  IRQ 4, on logical device 2 of the Super I/O at config port 0x2E.
+	  The BC-250's Super I/O is a Nuvoton NCT6686D; its COM1 logical
