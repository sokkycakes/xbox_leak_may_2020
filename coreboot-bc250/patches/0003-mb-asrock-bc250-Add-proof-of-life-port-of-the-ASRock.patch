+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * BC-250 proof of life.
+ *
+ * Getting here at all means the PSP accepted this image: it ran the stock
+ * ABL from our PSP directory, trained the GDDR6, copied this bootblock into
+ * DRAM and released the x86 core. The APOB check below confirms the ABL ran.
+ */
+
+#include <amdblocks/apob_cache.h>
+#include <amdblocks/lpc.h>
+#include <bootblock_common.h>
+#include <console/console.h>
+#include <cpu/cpu.h>
+#include <cpu/x86/name.h>
+#include <delay.h>
+#include <halt.h>
+#include <cf9_reset.h>
+#include <stdint.h>
+#include <superio/nuvoton/common/nuvoton.h>
+#include <superio/nuvoton/nct6687d/nct6687d.h>
+
+struct apob_header_peek {
+	uint32_t signature;
+	uint32_t version;
+	uint32_t size;
+};
+
+static void report_apob(void)
+{
+	const struct apob_header_peek *apob =
+		(const void *)(uintptr_t)CONFIG_PSP_APOB_DRAM_ADDRESS;
+
+	if (apob->signature == APOB_SIGNATURE)
+		printk(BIOS_INFO, "BC-250: APOB at 0x%x, version 0x%x, %u bytes: "
+		       "the stock ABL trained memory\n",
+		       CONFIG_PSP_APOB_DRAM_ADDRESS, apob->version, apob->size);
+	else
+		printk(BIOS_ERR, "BC-250: no APOB at 0x%x (found 0x%08x)\n",
+		       CONFIG_PSP_APOB_DRAM_ADDRESS, apob->signature);
+}
+
+/*
+ * Super I/O COM1, as declared in the stock DSDT: Nuvoton at 0x2E/0x2F,
+ * logical device 2, 0x3F8. Runs before console init.
+ */
+void bootblock_mainboard_early_init(void)
+{
+	if (!CONFIG(BC250_CONSOLE_SIO_COM1))
+		return;
+
+	lpc_enable_sio_decode(LPC_SELECT_SIO_2E2F);
+	lpc_enable_decode(DECODE_ENABLE_SERIAL_PORT0);
+	nuvoton_enable_serial(PNP_DEV(0x2e, NCT6687D_SP1), CONFIG_TTYS0_BASE);
+}
+
+void bootblock_mainboard_init(void)
+{
+	char name[49];
+
+	post_code(0x25);
+	fill_processor_name(name);
+	printk(BIOS_INFO, "\nBC-250: coreboot bootblock is running from DRAM\n");
+	printk(BIOS_INFO, "BC-250: CPU \"%s\", CPUID 1 EAX = 0x%08x\n",
+	       name, cpuid_eax(1));
+	report_apob();
+
+	if (CONFIG(BC250_PROOF_OF_LIFE_HALT)) {
+		printk(BIOS_INFO, "BC-250: proof of life done, halting\n");
+		post_code(0x2f);
+		halt();
+	}
+
+	if (CONFIG(BC250_PROOF_OF_LIFE_RESET_LOOP)) {
+		printk(BIOS_INFO, "BC-250: proof of life done, resetting in %d s\n",
+		       CONFIG_BC250_RESET_LOOP_SECONDS);
+		post_code(0x2e);
+		mdelay(CONFIG_BC250_RESET_LOOP_SECONDS * 1000);
+		full_reset();
+	}
+}
