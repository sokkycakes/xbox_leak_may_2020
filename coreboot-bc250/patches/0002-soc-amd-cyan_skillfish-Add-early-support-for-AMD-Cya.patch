+# PSP fw config file for AMD Cyan Skillfish (ASRock BC-250)
+#
+# Every file here is copied verbatim out of the stock BC-250 BIOS by
+# extract_stock_blobs.py; the list mirrors the stock level-1 PSP directory
+# entry for entry. amdfwtool's CyanSkillfish platform lays it out like
+# Picasso (single-level directories, pre-second-gen EFS) minus the soft fuse
+# and PSB signature entries, which the stock image does not have.
+
+FIRMWARE_LOCATION      3rdparty/bc250_blobs
+SOC_NAME               CyanSkillfish
+
+# type                    file
+PSPBTLDR_FILE          PspBootLoader.sbin
+PSPSECUREOS_FILE       PspSecureOs.sbin
+PSP_SMUFW1_SUB0_FILE   SmuFirmware.csbin
+PSP_SEC_DBG_KEY_FILE   SecureDebugPublicKey.bin
+PSP_SMUFW2_SUB0_FILE   SmuFirmware2.csbin
+PSP_SEC_DEBUG_FILE     SecureDebugUnlock.sbin
+PSP_HW_IPCFG_FILE_SUB0 HwIpConfig.sbin
+PSP_SECG0_FILE         SecGasket.sbin
+PSP_DRIVERS_FILE       PspDrivers.sbin
+PSP_ABL0_FILE          AgesaBootloader0.csbin
+PSP_ABL1_FILE          AgesaBootloader1.csbin
+PSP_ABL2_FILE          AgesaBootloader2.csbin
+PSP_ABL3_FILE          AgesaBootloader3.csbin
+PSP_ABL4_FILE          AgesaBootloader4.csbin
+UNIFIEDUSB_FILE        UsbPhy.sbin
+SECURE_POLICY_L1_FILE  TosSecurityPolicy.sbin
+PSP_UMC_FW_FILE        UmcFirmware.csbin
+KEYDBBL_FILE           KeyDbBootloader.bin
+KEYDB_TOS_FILE         KeyDbTos.bin
