+# SPDX-License-Identifier: GPL-2.0-only
+
+# AMD Cyan Skillfish ("RBN" in AMD's AGESA, "Ariel" in its module names):
+# the cut-down PS5 APU on the ASRock BC-250. Family 17h model 47h, Zen 2
+# cores with a Raven/Picasso-style NBIO and SMU v10.
+#
+# There is no FSP and no openSIL for this SoC. The PSP trains GDDR6 with the
+# ABL blobs taken from the stock BIOS and copies the x86 reset image into
+# DRAM, exactly like Picasso, so the non-CAR boot flow is reused as-is.
+# Everything AGESA does after memory init still has to be written.
+
+config SOC_AMD_CYAN_SKILLFISH
+	bool
+	select ACPI_SOC_NVS
+	select ARCH_X86
+	select BOOT_DEVICE_SUPPORTS_WRITES if BOOT_DEVICE_SPI_FLASH
+	select DRIVERS_USB_PCI_XHCI
+	select GENERIC_GPIO_LIB
+	select HAVE_ACPI_TABLES
+	select HAVE_CF9_RESET
+	select HAVE_SMI_HANDLER
+	select IDT_IN_EVERY_STAGE
+	select PARALLEL_MP_AP_WORK
+	select PROVIDES_ROM_SHARING
+	select RTC
+	select AMD_FWM_POSITION_820000_DEFAULT
+	select SOC_AMD_COMMON
+	select SOC_AMD_COMMON_BLOCK_ACPI
+	select SOC_AMD_COMMON_BLOCK_ACPIMMIO
+	select SOC_AMD_COMMON_BLOCK_ACPIMMIO_PM_IO_ACCESS
+	select SOC_AMD_COMMON_BLOCK_ACPI_CPU_POWER_STATE
+	select SOC_AMD_COMMON_BLOCK_ACPI_GPIO
+	select SOC_AMD_COMMON_BLOCK_ACPI_IVRS
+	select SOC_AMD_COMMON_BLOCK_ACPI_MADT
+	select SOC_AMD_COMMON_BLOCK_AOAC
+	select SOC_AMD_COMMON_BLOCK_APOB
+	select SOC_AMD_COMMON_BLOCK_BANKED_GPIOS
+	select SOC_AMD_COMMON_BLOCK_CONFIG
+	select SOC_AMD_COMMON_BLOCK_CPUFREQ_FAM17H_19H
+	select SOC_AMD_COMMON_BLOCK_DATA_FABRIC
+	select SOC_AMD_COMMON_BLOCK_DATA_FABRIC_DOMAIN
+	select SOC_AMD_COMMON_BLOCK_HAS_ESPI
+	select SOC_AMD_COMMON_BLOCK_I2C
+	select SOC_AMD_COMMON_BLOCK_I2C_PAD_CTRL
+	select SOC_AMD_COMMON_BLOCK_IOMMU
+	select SOC_AMD_COMMON_BLOCK_LPC
+	select SOC_AMD_COMMON_BLOCK_MCAX
+	select SOC_AMD_COMMON_BLOCK_NONCAR
+	select SOC_AMD_COMMON_BLOCK_PCI
+	select SOC_AMD_COMMON_BLOCK_PM
+	select SOC_AMD_COMMON_BLOCK_PM_CHIPSET_STATE_SAVE
+	select SOC_AMD_COMMON_BLOCK_PSP_GEN2
+	select SOC_AMD_COMMON_BLOCK_RESET
+	select SOC_AMD_COMMON_BLOCK_SMBUS
+	select SOC_AMD_COMMON_BLOCK_SMI
+	select SOC_AMD_COMMON_BLOCK_SMIHANDLER
+	select SOC_AMD_COMMON_BLOCK_SMM
+	select SOC_AMD_COMMON_BLOCK_SMU
+	select SOC_AMD_COMMON_BLOCK_SMU_SX_ENTRY
+	select SOC_AMD_COMMON_BLOCK_SPI
+	select SOC_AMD_COMMON_BLOCK_SVI2
+	select SOC_AMD_COMMON_BLOCK_TSC
+	select SOC_AMD_COMMON_BLOCK_UART
+	select SOC_AMD_COMMON_BLOCK_UCODE
+	select SOC_AMD_SUPPORTS_WARM_RESET
+	select SSE2
+	select X86_AMD_FIXED_MTRRS
+	select HAVE_X86_64_SUPPORT
+	help
+	  AMD Cyan Skillfish (BC-250) support
+
+if SOC_AMD_CYAN_SKILLFISH
+
+config CHIPSET_DEVICETREE
+	string
+	default "soc/amd/cyan_skillfish/chipset.cb"
+
+config EARLY_RESERVED_DRAM_BASE
+	hex
+	default 0x3ff0000
+	help
+	  Base of the DRAM coreboot uses before ramstage. The early stack sits
+	  here, directly below the APOB at 0x4000000 (where the stock BIOS has
+	  the ABL put it), followed by bootblock and romstage.
+
+config EARLYRAM_BSP_STACK_SIZE
+	hex
+	default 0x1000
+
+config PSP_APOB_DRAM_ADDRESS
+	hex
+	default 0x4000000
+	help
+	  Where the PSP copies the AGESA PSP Output Block. 0x4000000 is what
+	  the stock BC-250 BIOS directory uses, so the stock ABL is known to
+	  accept it.
+
+config PSP_APOB_DRAM_SIZE
+	hex
+	default 0x10000
+
+config PSP_SHAREDMEM_BASE
+	hex
+	default 0x0
+
+config PSP_SHAREDMEM_SIZE
+	hex
+	default 0x0
+
+config PRERAM_CBMEM_CONSOLE_SIZE
+	hex
+	default 0x1600
+
+config C_ENV_BOOTBLOCK_SIZE
+	hex
+	default 0x20000
+
+config ROMSTAGE_ADDR
+	hex
+	default 0x4050000
+
+config ROMSTAGE_SIZE
+	hex
+	default 0x70000
+
+config ECAM_MMCONF_BASE_ADDRESS
+	default 0xF8000000
+
+config ECAM_MMCONF_BUS_NUMBER
+	default 64
+
+config MAX_CPUS
+	int
+	default 16
+	help
+	  8 Zen 2 cores with SMT. Stock BC-250 boards ship with 6 enabled.
+
+config VGA_BIOS_ID
+	string
+	default "1002,13fe"
+
+config VGA_BIOS_FILE
+	string
+	default "3rdparty/bc250_blobs/vbios-113-AMDRBN-003.bin"
+
+config S3_VGA_ROM_RUN
+	bool
+	default n
+
+config SERIRQ_CONTINUOUS_MODE
+	bool
+	default n
+
+config CONSOLE_UART_BASE_ADDRESS
+	depends on (CONSOLE_SERIAL || CONSOLE_SERIAL_RUNTIME) && AMD_SOC_CONSOLE_UART
+	hex
+	default 0xfedc9000 if UART_FOR_CONSOLE = 0
+	default 0xfedca000 if UART_FOR_CONSOLE = 1
+	default 0xfedce000 if UART_FOR_CONSOLE = 2
+	default 0xfedcf000 if UART_FOR_CONSOLE = 3
+
+config SMM_TSEG_SIZE
+	hex
+	default 0x800000 if HAVE_SMI_HANDLER
+	default 0x0
+
+config SMM_RESERVED_SIZE
+	hex
+	default 0x180000
+
+config SMM_MODULE_STACK_SIZE
+	hex
+	default 0x800
+
+config DRIVERS_I2C_DESIGNWARE_CLOCK_MHZ
+	int
+	default 150
+
+config DISABLE_SPI_FLASH_ROM_SHARING
+	def_bool n
+
+config DISABLE_KEYBOARD_RESET_PIN
+	bool
+
+menu "PSP Configuration Options"
+
+config AMDFW_CONFIG_FILE
+	string
+	default "src/soc/amd/cyan_skillfish/fw.cfg"
+
+config CYAN_SKILLFISH_BLOBS_DIR
+	string "Directory with the PSP blobs extracted from a stock BIOS"
+	default "3rdparty/bc250_blobs"
+	help
+	  Output directory of extract_stock_blobs.py. coreboot ships no AMD
+	  blobs for this SoC; every PSP entry, the APCB and the VBIOS are
+	  copied verbatim from ASRock's BC-250 BIOS.
+
+endmenu
+
+endif # SOC_AMD_CYAN_SKILLFISH
diff --git a/src/soc/amd/cyan_skillfish/Makefile.mk b/src/soc/amd/cyan_skillfish/Makefile.mk
new file mode 100644
index 00000000..b6a43a29
--- /dev/null
+++ b/src/soc/amd/cyan_skillfish/Makefile.mk
@@ -0,0 +1,116 @@
+# SPDX-License-Identifier: BSD-3-Clause
+
+ifeq ($(CONFIG_SOC_AMD_CYAN_SKILLFISH),y)
+
+all-y += aoac.c
+all-y += i2c.c
+
+all_x86-y += gpio.c
+all_x86-y += uart.c
+
+bootblock-y += early_fch.c
+
+
+ramstage-$(CONFIG_HAVE_ACPI_TABLES) += acpi.c
+romstage-y += cbmem.c
+ramstage-y += cbmem.c
+ramstage-y += chip.c
+ramstage-y += cpu.c
+ramstage-y += fch.c
+ramstage-y += mca.c
+ramstage-y += pci_routing.c
+ramstage-y += memmap.c
+ramstage-y += root_complex.c
+
+ifeq ($(CONFIG_DEBUG_SMI),y)
+smm-y += uart.c
+endif
+smm-y += gpio.c
+smm-y += root_complex.c
+
+CPPFLAGS_common += -I$(src)/soc/amd/cyan_skillfish/include
+CPPFLAGS_common += -I$(src)/soc/amd/cyan_skillfish/acpi
+
+#
+# PSP image. Everything except the x86 reset image is copied verbatim from
+# the stock BC-250 BIOS (see fw.cfg and extract_stock_blobs.py), and the
+# directory layout mirrors the stock one:
+#   EFS -> one $PSP directory -> one $BHD directory
+#   $BHD: APCB (0x60), APOB (0x61), reset image (0x62), APOB NV (0x63)
+# The stock reset image is stored uncompressed, so ours is too.
+#
+
+BC250_BLOBS=$(call strip_quotes,$(CONFIG_CYAN_SKILLFISH_BLOBS_DIR))
+
+# type = 0x60
+PSP_APCB_FILES=$(BC250_BLOBS)/APCB.bin
+
+# type = 0x61
+PSP_APOB_BASE=$(CONFIG_PSP_APOB_DRAM_ADDRESS)
+
+# type = 0x62
+PSP_BIOSBIN_FILE=$(obj)/amd_biospsp.img
+PSP_ELF_FILE=$(objcbfs)/bootblock_fixed_data.elf
+PSP_BIOSBIN_SIZE=$(shell $(READELF_bootblock) -Wl $(PSP_ELF_FILE) | grep LOAD | awk '{print $$5}')
+PSP_BIOSBIN_DEST=$(shell $(READELF_bootblock) -Wl $(PSP_ELF_FILE) | grep LOAD | awk '{print $$3}')
+
+# type = 0x63 - the stock image has an (erased) APOB NV copy; keep the entry.
+APOB_NV_SIZE=$(call get_fmap_value,FMAP_SECTION_RW_MRC_CACHE_SIZE)
+APOB_NV_BASE=$(call get_fmap_value,FMAP_SECTION_RW_MRC_CACHE_START)
+
+add_opt_prefix=$(if $(call strip_quotes, $(1)), $(2) $(call strip_quotes, $(1)), )
+
+OPT_PSP_APCB_FILES=$(call add_opt_prefix, $(PSP_APCB_FILES), --instance 0 --apcb)
+OPT_APOB_ADDR=$(call add_opt_prefix, $(PSP_APOB_BASE), --apob-base)
+OPT_PSP_BIOSBIN_FILE=$(call add_opt_prefix, $(PSP_BIOSBIN_FILE), --bios-bin)
+OPT_PSP_BIOSBIN_DEST=$(call add_opt_prefix, $(PSP_BIOSBIN_DEST), --bios-bin-dest)
+OPT_PSP_BIOSBIN_SIZE=$(call add_opt_prefix, $(PSP_BIOSBIN_SIZE), --bios-uncomp-size)
+OPT_APOB_NV_SIZE=$(call add_opt_prefix, $(APOB_NV_SIZE), --apob-nv-size)
+OPT_APOB_NV_BASE=$(call add_opt_prefix, $(APOB_NV_BASE), --apob-nv-base)
+OPT_EFS_SPI_READ_MODE=$(call add_opt_prefix, $(CONFIG_EFS_SPI_READ_MODE), --spi-read-mode)
+OPT_EFS_SPI_SPEED=$(call add_opt_prefix, $(CONFIG_EFS_SPI_SPEED), --spi-speed)
+OPT_EFS_SPI_MICRON_FLAG=$(call add_opt_prefix, $(CONFIG_EFS_SPI_MICRON_FLAG), --spi-micron-flag)
+
+# The stock EFS also points at an "IMC" and an xHCI blob.
+OPT_IMC_FILE=--imc $(BC250_BLOBS)/Imc.bin
+OPT_XHCI_FILE=--xhci $(BC250_BLOBS)/Xhci.bin
+
+$(obj)/amdfw.rom:	$(call strip_quotes, $(PSP_BIOSBIN_FILE)) \
+			$(PSP_APCB_FILES) \
+			$(AMDFWTOOL) \
+			$(obj)/fmap_config.h \
+			$(objcbfs)/bootblock_fixed_data.elf # this target also creates the .map file
+	$(if $(wildcard $(PSP_APCB_FILES)), ,$(error $(PSP_APCB_FILES) missing: run extract_stock_blobs.py on a stock BC-250 BIOS first))
+	rm -f $@
+	@printf "    AMDFWTOOL  $(subst $(obj)/,,$(@))\n"
+	$(AMDFWTOOL) \
+		$(OPT_PSP_APCB_FILES) \
+		$(OPT_APOB_ADDR) \
+		$(OPT_DEBUG_AMDFWTOOL) \
+		$(OPT_PSP_BIOSBIN_FILE) \
+		$(OPT_PSP_BIOSBIN_DEST) \
+		$(OPT_PSP_BIOSBIN_SIZE) \
+		--bios-bin-uncomp \
+		$(OPT_APOB_NV_SIZE) \
+		$(OPT_APOB_NV_BASE) \
+		$(OPT_IMC_FILE) \
+		$(OPT_XHCI_FILE) \
+		--use-pspsecureos \
+		$(OPT_EFS_SPI_READ_MODE) \
+		$(OPT_EFS_SPI_SPEED) \
+		$(OPT_EFS_SPI_MICRON_FLAG) \
+		--config $(CONFIG_AMDFW_CONFIG_FILE) \
+		--flashsize $(CONFIG_ROM_SIZE) \
+		--location $(CONFIG_AMD_FWM_POSITION) \
+		--output $@
+
+# Copy the first PT_LOAD segment of the bootblock ELF out uncompressed. The
+# PSP copies it to PSP_BIOSBIN_DEST and releases the x86 at
+# PSP_BIOSBIN_DEST + PSP_BIOSBIN_SIZE - 0x10.
+$(PSP_BIOSBIN_FILE): $(PSP_ELF_FILE) $(AMDCOMPRESS)
+	rm -f $@
+	@printf "    AMDCOMPRS  $(subst $(obj)/,,$(@))\n"
+	$(AMDCOMPRESS) --infile $(PSP_ELF_FILE) --outfile $@ --elfcopy \
+		--maxsize $(PSP_BIOSBIN_SIZE)
+
+endif # ($(CONFIG_SOC_AMD_CYAN_SKILLFISH),y)
