# LinuxBoot kernel for the ASRock BC-250 (AMD Cyan Skillfish, family 17h model 47h)
# Applied on top of allnoconfig via scripts/kconfig/merge_config.sh.
# Everything is built in and the u-root initramfs is linked into the kernel,
# so the result is one EFI file (bootable from USB today) that is also small
# enough to go into SPI flash later.

# --- Core ---
CONFIG_64BIT=y
CONFIG_LOCALVERSION="-linuxboot-bc250"
CONFIG_DEFAULT_HOSTNAME="linuxboot"
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_FHANDLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_INITRAMFS_SOURCE="@INITRAMFS@"
CONFIG_INITRAMFS_COMPRESSION_XZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
# Super I/O COM1 (0x3F8, see ../README.md) plus the screen.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200 console=tty0 earlyprintk=serial,ttyS0,115200"

# --- EFI: booted by the stock UEFI as an EFI application ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=n
CONFIG_EFIVAR_FS=y
CONFIG_EFI_ESRT=y
CONFIG_FB_EFI=y

# --- CPU / platform: Zen 2, 6 cores / 12 threads ---
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_CPU_SUP_AMD=y
CONFIG_CPU_SUP_INTEL=n
CONFIG_X86_MCE=y
CONFIG_X86_MCE_AMD=y
CONFIG_MICROCODE=y
CONFIG_AMD_NB=y
CONFIG_HPET_TIMER=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_PM=y
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_SIG=n
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_HWMON=y
CONFIG_SENSORS_K10TEMP=y
# The BC-250 needs the IOMMU off (community finding); keep it out entirely.
CONFIG_AMD_IOMMU=n

# --- PCI / buses / GPIO ---
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_I2C=y
CONFIG_I2C_PIIX4=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_GPIOLIB=y
CONFIG_DEBUG_FS=y

# --- Serial ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_8250_DW=y
CONFIG_PNP=y

# --- Storage: M.2 NVMe, SATA, USB sticks ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# --- USB ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y

# --- Input ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y

# --- Network: on-board RTL8111H, plus common USB NICs ---
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_RTL8152=y
# Lets QEMU tests use a virtio NIC and disk; tiny, harmless on hardware.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# --- Graphics: reuse the stock GOP framebuffer, no amdgpu ---
# amdgpu would need the Cyan Skillfish firmware linked in. LinuxBoot only
# needs a text console; Bazzite's own kernel brings amdgpu up after kexec.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# --- Filesystems: Bazzite /boot is ext4, root btrfs, ESP vfat ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_FAT_DEFAULT_UTF8=y

# --- Crypto ---
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
