+// A download or a game installed from the Games screen, not a save.
+int CSavedGameGrid::IsGameSelected()
+{
+	if (m_curTitle < 0 || m_curSavedGame < 0 || IsSoundtrackSelected())
+		return false;
+
+	return g_titles[m_curDevUnit].GetSavedGameKind(m_curTitle, m_curSavedGame) != 0;
+}
+
+// How many of a title's items are downloads or installed games.
+int CSavedGameGrid::GetGameCount(int nTitle)
+{
+	if (nTitle < 0 || (m_nSoundtrackTitle >= 0 && nTitle >= m_nSoundtrackTitle))
+		return 0;
+
+	int nGames = 0;
+	int nSavedGameCount = GetSavedGameCount(nTitle);
+	for (int i = 0; i < nSavedGameCount; i += 1)
+	{
+		if (g_titles[m_curDevUnit].GetSavedGameKind(nTitle, i) != 0)
+			nGames += 1;
+	}
+	return nGames;
+}
