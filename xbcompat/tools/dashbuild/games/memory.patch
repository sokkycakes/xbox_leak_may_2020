 ////////////////////////////////////////////////////////////////////////////
+// xbcompat's dashbuild: on the hard disk the Memory screen also lists what
+// takes up room besides saves, the way later Xbox dashboards did: the content
+// a title downloaded (TDATA\<title>\$C\<content>, e.g. each Xbox Live Arcade
+// game under Xbox Live Arcade) and the games installed from the Games screen
+// (c:\Games\<folder>, under the title their XBE names).  Each is an item next
+// to the title's saves and can be deleted there.
+
+// GameCollection.cpp
+extern bool ReadXbeTitleInfo(const CHAR* szXbe, DWORD* pdwTitleID, DWORD* pdwTimeDate, WCHAR* szName /*[41]*/);
+extern bool CacheXbeTitleImage(const CHAR* szXbe, CHAR* szCache /*[MAX_PATH]*/);
+
+#define MAX_INSTALLED_GAMES 256
+
+struct INSTALLEDGAME
+{
+	CHAR m_szFolder[64];		// c:\Games\<m_szFolder>
+	CHAR m_szXbe[64];			// its XBE
+	TCHAR m_szOwner[16];		// the title it is listed under
+	WCHAR m_szName[41];
+	DWORD m_dwTitleID;
+	DWORD m_dwTimeDate;
+	FILETIME m_ft;
+};
+
+static INSTALLEDGAME* c_rgInstalled = NULL;
+static int c_nInstalled = 0;
+
+// Titles whose only data are downloads and have no TitleMeta.xbx of their own.
+static const struct { const TCHAR* szID; const TCHAR* szName; } c_rgKnownTitles [] =
+{
+	{ _T("4d5300c8"), _T("Xbox Live Arcade") },
+};
+
+static void ScanInstalledGames()
+{
+	if (c_rgInstalled == NULL)
+		c_rgInstalled = new INSTALLEDGAME [MAX_INSTALLED_GAMES];
+	c_nInstalled = 0;
+
+	WIN32_FIND_DATAA fd;
+	HANDLE hFind = FindFirstFileA("c:\\Games\\*", &fd);
+	if (hFind == INVALID_HANDLE_VALUE)
+		return;
+
+	do
+	{
+		if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || fd.cFileName[0] == '.' ||
+			strlen(fd.cFileName) >= sizeof (c_rgInstalled[0].m_szFolder))
+			continue;
+
+		INSTALLEDGAME* pGame = &c_rgInstalled[c_nInstalled];
+		ZeroMemory(pGame, sizeof (INSTALLEDGAME));
+		strcpy(pGame->m_szFolder, fd.cFileName);
+		strcpy(pGame->m_szXbe, "default.xbe");
+		pGame->m_ft = fd.ftLastWriteTime;
+
+		// default.xbe, or else the folder's one XBE (as the Games screen does)
+		CHAR szPath [MAX_PATH];
+		sprintf(szPath, "c:\\Games\\%s\\default.xbe", fd.cFileName);
+		if (GetFileAttributesA(szPath) == (DWORD)-1)
+		{
+			WIN32_FIND_DATAA fdXbe;
+			sprintf(szPath, "c:\\Games\\%s\\*.xbe", fd.cFileName);
+			HANDLE hXbe = FindFirstFileA(szPath, &fdXbe);
+			if (hXbe == INVALID_HANDLE_VALUE)
+				continue;
+			lstrcpynA(pGame->m_szXbe, fdXbe.cFileName, sizeof (pGame->m_szXbe));
+			FindClose(hXbe);
+		}
+		sprintf(szPath, "c:\\Games\\%s\\%s", fd.cFileName, pGame->m_szXbe);
+		if (!ReadXbeTitleInfo(szPath, &pGame->m_dwTitleID, &pGame->m_dwTimeDate, pGame->m_szName))
+			continue;
+
+		if (pGame->m_szName[0] == 0)
+		{
+			for (int i = 0; i < 40 && fd.cFileName[i]; i += 1)
+				pGame->m_szName[i] = fd.cFileName[i], pGame->m_szName[i + 1] = 0;
+		}
+		_stprintf(pGame->m_szOwner, _T("%08x"), pGame->m_dwTitleID);
+		c_nInstalled += 1;
+	}
+	while (c_nInstalled < MAX_INSTALLED_GAMES && FindNextFileA(hFind, &fd));
+
+	FindClose(hFind);
+}
+
+static INSTALLEDGAME* FindInstalledGame(const TCHAR* szFolder)
+{
+	CHAR sz [64];
+	Ansi(sz, szFolder, countof(sz));
+	for (int i = 0; i < c_nInstalled; i += 1)
+	{
+		if (_stricmp(c_rgInstalled[i].m_szFolder, sz) == 0)
+			return &c_rgInstalled[i];
+	}
+	return NULL;
+}
+
+// Whether TDATA\<szTitleID> holds any downloads ($C\<content> folders).
+static bool HasContent(const TCHAR* szTData, const TCHAR* szTitleID)
+{
+	TCHAR szWild [MAX_PATH];
+	MakePath(szWild, szTData, szTitleID);
+	MakePath(szWild, szWild, _T("$C\\*.*"));
+
+	CHAR szBuf [MAX_PATH];
+	Ansi(szBuf, szWild, countof(szBuf));
+	WIN32_FIND_DATAA fd;
+	HANDLE hFind = FindFirstFileA(szBuf, &fd);
+	if (hFind == INVALID_HANDLE_VALUE)
+		return false;
+
+	bool bFound = false;
+	do
+	{
+		if ((fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 && fd.cFileName[0] != '.')
+			bFound = true;
+	}
+	while (!bFound && FindNextFileA(hFind, &fd));
+	FindClose(hFind);
+	return bFound;
+}
+
+// The Name= of a ContentMeta.xbx: an "XCSF" header (its size at 0x18) whose
+// title metadata (offset and size at 0x34) is UTF-16 text in TitleMeta.xbx
+// form, one [section] per language: [default] Name="..." [FR] Name="..."
+static bool ReadContentName(const TCHAR* szContentDir, TCHAR* szName, int cchName)
+{
+	TCHAR szPath [MAX_PATH];
+	MakePath(szPath, szContentDir, _T("ContentMeta.xbx"));
+	CHAR szBuf [MAX_PATH];
+	Ansi(szBuf, szPath, countof(szBuf));
+
+	HANDLE hFile = CreateFileA(szBuf, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+	if (hFile == INVALID_HANDLE_VALUE)
+		return false;
+
+	BYTE rgb [4096];
+	DWORD cb = 0;
+	BOOL bRead = ReadFile(hFile, rgb, sizeof (rgb), &cb, NULL);
+	CloseHandle(hFile);
+	if (!bRead || cb < 0x3C || *(DWORD*)(rgb + 0x14) != 'FSCX')
+		return false;
+
+	DWORD dwOffset = *(DWORD*)(rgb + 0x34);
+	DWORD dwSize = *(DWORD*)(rgb + 0x38);
+	if (dwOffset >= cb || dwSize > cb - dwOffset || dwSize < 4)
+		return false;
+
+	const WCHAR* pch = (const WCHAR*)(rgb + dwOffset);
+	const WCHAR* pchLim = pch + dwSize / sizeof (WCHAR);
+	if (*pch == 0xFEFF)
+		pch += 1;
+
+	TCHAR szLang [MAX_LANGUAGE_CODE_LEN];
+	GetLanguageCode(szLang);
+
+	bool bFound = false;
+	bool bDefault = false, bLang = false;
+	while (pch < pchLim && *pch != 0)
+	{
+		// one line
+		const WCHAR* pchEnd = pch;
+		while (pchEnd < pchLim && *pchEnd != 0 && *pchEnd != '\r' && *pchEnd != '\n')
+			pchEnd += 1;
+
+		int cch = pchEnd - pch;
+		if (cch > 2 && pch[0] == '[' && pch[cch - 1] == ']')
+		{
+			bDefault = (cch == 9 && _wcsnicmp(pch + 1, L"default", 7) == 0);
+			bLang = ((int)_tcslen(szLang) == cch - 2 && _wcsnicmp(pch + 1, szLang, cch - 2) == 0);
+		}
+		else if ((bDefault || bLang) && cch > 5 && _wcsnicmp(pch, L"Name=", 5) == 0 && (bLang || !bFound))
+		{
+			const WCHAR* pchValue = pch + 5;
+			const WCHAR* pchValueEnd = pchEnd;
+			if (pchValueEnd - pchValue >= 2 && *pchValue == '"' && pchValueEnd[-1] == '"')
+				pchValue += 1, pchValueEnd -= 1;
+
+			int n = pchValueEnd - pchValue;
+			if (n > cchName - 1)
+				n = cchName - 1;
+			CopyMemory(szName, pchValue, n * sizeof (WCHAR));
+			szName[n] = 0;
+			bFound = n > 0;
+			if (bFound && bLang)
+				break;
+		}
+
+		pch = pchEnd;
+		while (pch < pchLim && (*pch == '\r' || *pch == '\n'))
+			pch += 1;
+	}
+
+	return bFound;
+}
