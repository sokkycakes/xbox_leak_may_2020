 bool InitSave(CSave* pSave, const TCHAR* szRoot, const TCHAR* szTitleID, const TCHAR* szSaveDirName, FILETIME saveTime);
 
+static int __cdecl SortItemCompare(const void *elem1, const void *elem2)
+{
+	// Installed games first, then downloads, then saves; newest first in each
+	const CSave* pSave1 = (const CSave*)elem1;
+	const CSave* pSave2 = (const CSave*)elem2;
+	int nKind1 = (pSave1->m_dwFlags & SAVEFLAG_GAME) ? 0 : (pSave1->m_dwFlags & SAVEFLAG_CONTENT) ? 1 : 2;
+	int nKind2 = (pSave2->m_dwFlags & SAVEFLAG_GAME) ? 0 : (pSave2->m_dwFlags & SAVEFLAG_CONTENT) ? 1 : 2;
+	if (nKind1 != nKind2)
+		return nKind1 - nKind2;
+	return CompareFileTime(&pSave2->m_filetime, &pSave1->m_filetime);
+}
+
+// A title's saves, plus on the hard disk its downloads and installed games.
+int CTitleArray::ScanTitle(int nTitle, CSave* rgsaves /*[MAX_SAVED_GAMES]*/, HANDLE hCancelEvent)
+{
+	const TCHAR* szTitleID = m_rgtitle[nTitle].m_szID;
+	int nCount = ScanSavedGames(GetUData(), szTitleID, rgsaves, hCancelEvent);
+	if (nCount < 0 || m_szRoot[0] != 'c')
+		return nCount;
+
+	int nSaves = nCount;
+
+	// BLOCK: downloads in TDATA\<title>\$C
+	{
+		TCHAR szWild [MAX_PATH];
+		MakePath(szWild, GetTData(), szTitleID);
+		MakePath(szWild, szWild, _T("$C\\*.*"));
+
+		CHAR szBuf [MAX_PATH];
+		Ansi(szBuf, szWild, countof(szBuf));
+		WIN32_FIND_DATAA fd;
+		HANDLE hFind = FindFirstFileA(szBuf, &fd);
+		if (hFind != INVALID_HANDLE_VALUE)
+		{
+			do
+			{
+				if ((fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0 || fd.cFileName[0] == '.' ||
+					nCount == MAX_SAVED_GAMES)
+					continue;
+
+				TCHAR szName [MAX_PATH];
+				Unicode(szName, fd.cFileName, countof(szName));
+				if (!InitSave(&rgsaves[nCount], GetTData(), szTitleID, szName, fd.ftLastWriteTime))
+					continue;
+				rgsaves[nCount].m_dwFlags |= SAVEFLAG_CONTENT;
+				nCount += 1;
+			}
+			while (FindNextFileA(hFind, &fd));
+			FindClose(hFind);
+		}
+	}
+
+	// BLOCK: games installed from the Games screen
+	for (int i = 0; i < c_nInstalled && nCount < MAX_SAVED_GAMES; i += 1)
+	{
+		if (_tcsicmp(c_rgInstalled[i].m_szOwner, szTitleID) != 0)
+			continue;
+
+		TCHAR szName [64];
+		Unicode(szName, c_rgInstalled[i].m_szFolder, countof(szName));
+		if (!InitSave(&rgsaves[nCount], GetUData(), szTitleID, szName, c_rgInstalled[i].m_ft))
+			continue;
+		rgsaves[nCount].m_dwFlags |= SAVEFLAG_GAME;
+		nCount += 1;
+	}
+
+	if (nCount > nSaves)
+		qsort(rgsaves, nCount, sizeof (CSave), SortItemCompare);
+
+	return nCount;
+}
+
+DWORD CTitleArray::GetSavedGameKind(int nTitle, int nSavedGame)
+{
+	if (m_bDirty || nTitle < 0 || nTitle >= m_nTitleCount || nSavedGame < 0 || nSavedGame >= m_rgtitle[nTitle].m_nSavedGameCount)
+		return 0;
+
+	return m_rgtitle[nTitle].m_rgsaves[nSavedGame].m_dwFlags & (SAVEFLAG_CONTENT | SAVEFLAG_GAME);
+}
+
+// The folder that holds a save, a download or an installed game.
+bool CTitleArray::GetSavedGamePath(int nTitle, int nSavedGame, TCHAR* szPath/*[MAX_PATH]*/)
+{
+	if (nTitle < 0 || nTitle >= m_nTitleCount || nSavedGame < 0 || nSavedGame >= GetSavedGameCount(nTitle))
+		return false;
+
+	DWORD dwKind = GetSavedGameKind(nTitle, nSavedGame);
+	const TCHAR* szDirName = m_rgtitle[nTitle].m_rgsaves[nSavedGame].GetDirName();
+	if (dwKind & SAVEFLAG_GAME)
+	{
+		MakePath(szPath, _T("c:\\Games"), szDirName);
+	}
+	else if (dwKind & SAVEFLAG_CONTENT)
+	{
+		MakePath(szPath, GetTData(), m_rgtitle[nTitle].m_szID);
+		MakePath(szPath, szPath, _T("$C"));
+		MakePath(szPath, szPath, szDirName);
+	}
+	else
+	{
+		MakePath(szPath, GetUData(), m_rgtitle[nTitle].m_szID);
+		MakePath(szPath, szPath, szDirName);
+	}
+	return true;
+}
+
+// The name of a download or an installed game; false for a save (its name
+// is in its SaveMeta.xbx).
+bool CTitleArray::GetSavedGameName(int nTitle, int nSavedGame, TCHAR* szName, int cchName)
+{
+	DWORD dwKind = GetSavedGameKind(nTitle, nSavedGame);
+	if (dwKind & SAVEFLAG_GAME)
+	{
+		INSTALLEDGAME* pGame = FindInstalledGame(GetSavedGameID(nTitle, nSavedGame));
+		lstrcpyn(szName, pGame != NULL ? pGame->m_szName : GetSavedGameID(nTitle, nSavedGame), cchName);
+		return true;
+	}
+
+	if (dwKind & SAVEFLAG_CONTENT)
+	{
+		TCHAR szPath [MAX_PATH];
+		if (!GetSavedGamePath(nTitle, nSavedGame, szPath) || !ReadContentName(szPath, szName, cchName))
+			lstrcpyn(szName, GetSavedGameID(nTitle, nSavedGame), cchName);
+		return true;
+	}
+
+	return false;
+}
