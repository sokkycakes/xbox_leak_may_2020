--- /dev/null
+++ b/xbcompat/src/gpu/xemu/hw/xbox/nv2a/pmc.c
@@ -0,0 +1,73 @@
+/*
+ * QEMU Geforce NV2A implementation
+ *
+ * Copyright (c) 2012 espes
