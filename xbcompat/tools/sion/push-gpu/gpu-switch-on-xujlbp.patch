+
+    glDeleteProgram(r->s2t_rndr.prog);
+    r->s2t_rndr.prog = 0;
+
+    glDeleteVertexArrays(1, &r->s2t_rndr.vao);
+    r->s2t_rndr.vao = 0;
+
+    glDeleteBuffers(1, &r->s2t_rndr.vbo);
+    r->s2t_rndr.vbo = 0;
+
+    glDeleteFramebuffers(1, &r->s2t_rndr.fbo);
+    r->s2t_rndr.fbo = 0;
+}
