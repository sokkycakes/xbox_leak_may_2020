+#ifndef HW_XBOX_NV2A_PGRAPH_GLSL_GEOM_H
+#define HW_XBOX_NV2A_PGRAPH_GLSL_GEOM_H
+
+#include "common.h"
+#include "hw/xbox/nv2a/pgraph/vsh_regs.h"
+
+typedef struct {
+    enum ShaderPrimitiveMode primitive_mode;
+    enum ShaderPolygonMode polygon_front_mode;
+    enum ShaderPolygonMode polygon_back_mode;
+    bool smooth_shading;
+    bool first_vertex_is_provoking;
+    bool z_perspective;
+    short tri_rot0;
+    short tri_rot1;
+} GeomState;
+
+typedef struct GenGeomGlslOptions {
+    bool vulkan;
+} GenGeomGlslOptions;
+
+void pgraph_glsl_set_geom_state(PGRAPHState *pg, GeomState *geom);
+
+bool pgraph_glsl_need_geom(const GeomState *state);
+
+MString *pgraph_glsl_gen_geom(const GeomState *state, GenGeomGlslOptions opts);
+
+#endif
diff --git a/xbcompat/src/gpu/xemu/hw/xbox/nv2a/pgraph/glsl/psh.c b/xbcompat/src/gpu/xemu/hw/xbox/nv2a/pgraph/glsl/psh.c
new file mode 100644
index 00000000..b7325c36
--- /dev/null
+++ b/xbcompat/src/gpu/xemu/hw/xbox/nv2a/pgraph/glsl/psh.c
@@ -0,0 +1,1812 @@
+/*
+ * QEMU Geforce NV2A pixel shader translation
