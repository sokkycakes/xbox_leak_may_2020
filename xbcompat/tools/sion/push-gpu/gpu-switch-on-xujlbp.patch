+MString *pgraph_glsl_gen_psh(const PshState *state, GenPshGlslOptions opts);
+
+void pgraph_glsl_set_psh_uniform_values(PGRAPHState *pg,
+                                        const PshUniformLocs locs,
+                                        PshUniformValues *values);
