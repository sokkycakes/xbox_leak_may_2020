index 00000000..aa669520
--- /dev/null
+++ b/xbcompat/src/gpu/xemu/hw/xbox/nv2a/pgraph/gl/debug.c
@@ -0,0 +1,215 @@
+/*
+ * Geforce NV2A PGRAPH OpenGL Renderer
