From 2592c9473a3929e7dcb8099bc5108052f3247383 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 09:26:43 +0000
Subject: [PATCH 1/2] Fix MechAssault crash at its loading screen

MechAssault calls DoWork (vtable slot 9) on the XFileMediaObject it gets
from XFileCreateMediaObjectAsync. Our file XMO vtable stopped at
GetLength, so the call jumped to NULL and the game died, which on the
Sion looks like being sent back to the dashboard. Add a DoWork that
returns S_OK (our file objects complete synchronously).

The crash handler also tried to decode the instruction at EIP before
reporting a jump to unmapped code, and faulted again reading it, so no
crash report was logged. Skip the decoders when the fault is the fetch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01H46hG5LKXDzhHxLGAY5dE3
---
 xbcompat/src/hle/dsound.c | 12 ++++++++----
 xbcompat/src/main.c       |  4 +++-
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/xbcompat/src/hle/dsound.c b/xbcompat/src/hle/dsound.c
index d59d02c4..f4930599 100644
--- a/xbcompat/src/hle/dsound.c
+++ b/xbcompat/src/hle/dsound.c
@@ -2034,7 +2034,7 @@ struct ds_filexmo {
 };
 
 static void *wave_vtbl[11];
-static void *file_vtbl[9];
+static void *file_vtbl[10];
 
 static void xmo_accept(const XMEDIAPACKET *p)
 {
@@ -2260,6 +2260,8 @@ static HRESULT NTAPI File_GetLength(struct ds_filexmo *f, DWORD *len)
     return DS_OK;
 }
 
+static HRESULT NTAPI File_DoWork(struct ds_filexmo *f) { (void)f; return DS_OK; }
+
 static HRESULT NTAPI XFileCreateMediaObject(const char *name, DWORD access, DWORD share, DWORD disp, DWORD attrs,
                                             void **ppxmo)
 {
@@ -3183,9 +3185,11 @@ static void *wave_vtbl[11] = {
     (void *)Wave_GetFormat, (void *)Wave_GetLoopRegion,
 };
 
-static void *file_vtbl[9] = {
+/* Later XDKs add DoWork to XFileMediaObject for XFileCreateMediaObjectAsync
+   objects (MechAssault calls it while loading); ours complete at once. */
+static void *file_vtbl[10] = {
     (void *)File_AddRef, (void *)File_Release, (void *)File_GetInfo, (void *)File_GetStatus, (void *)File_Process,
-    (void *)File_Discontinuity, (void *)File_Flush, (void *)File_Seek, (void *)File_GetLength,
+    (void *)File_Discontinuity, (void *)File_Flush, (void *)File_Seek, (void *)File_GetLength, (void *)File_DoWork,
 };
 
 /* The guest calls these objects' methods through the vtables: give it
@@ -3195,7 +3199,7 @@ static void guest_vtbls_once(void)
     cpu_guest_table(refhdr_vtbl, 3);
     cpu_guest_table(stream_vtbl, 7);
     cpu_guest_table(wave_vtbl, 11);
-    cpu_guest_table(file_vtbl, 9);
+    cpu_guest_table(file_vtbl, 10);
 }
 
 static void guest_vtbls(void)
diff --git a/xbcompat/src/main.c b/xbcompat/src/main.c
index f9556634..6b84cd0e 100644
--- a/xbcompat/src/main.c
+++ b/xbcompat/src/main.c
@@ -78,7 +78,9 @@ static void crash_handler(int sig, siginfo_t *si, void *uc_)
 {
     ucontext_t *uc = uc_;
     greg_t *r = uc->uc_mcontext.gregs;
-    if (sig == SIGSEGV && (read_tsc(r) || debug_service(r) || privileged_insn(r))) { g_guest_traps++; return; }
+    /* A jump to unmapped code faults on the fetch: nothing to decode there. */
+    bool fetch = sig == SIGSEGV && (greg_t)si->si_addr == r[REG_EIP];
+    if (sig == SIGSEGV && !fetch && (read_tsc(r) || debug_service(r) || privileged_insn(r))) { g_guest_traps++; return; }
     if (sig == SIGSEGV && nic_trap_fault(si->si_addr, uc)) return;
     if (sig == SIGTRAP && nic_trap_step(uc)) return;
     if (sig == SIGTRAP && probe_trap(uc)) return;
