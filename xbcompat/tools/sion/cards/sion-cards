#!/bin/sh
# Read-only game cards for both Raspberry Pi and Sion. The Dashboard polls
# CARD0: under /media; this service follows USB/SD media without a restart.
# The path overrides and --once also allow isolated hotplug regression tests.
MEDIA=${SION_CARDS_MEDIA:-/media}
SYS=${SION_CARDS_SYS:-/sys/class/block}
MOUNTS=${SION_CARDS_MOUNTS:-/proc/mounts}
MOUNTINFO=${SION_CARDS_MOUNTINFO:-/proc/self/mountinfo}
STATE=${SION_CARDS_STATE:-/var/run/sion-cards}
PIDFILE=${SION_CARDS_PIDFILE:-/var/run/sion-cards.pid}

log() { logger -t sion-cards "$*"; }
running() { [ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
volumes() {
	parts=
	for p in "$SYS/$1/$1"*; do
		[ -e "$p/partition" ] && parts="$parts ${p##*/}"
	done
	echo "${parts:-$1}"
}

# Protect the entire disk if any partition is mounted outside /media, or
# carries a system label. Mountinfo identifies /dev/root by major:minor too.
system_disk() {
	for v in $(volumes "$1"); do
		num=$(cat "$SYS/$v/dev" 2>/dev/null)
		if [ -n "$num" ] && awk -v dev="$num" -v media="$MEDIA/" '
			$3 == dev && index($5, media) != 1 { found=1 }
			END { exit !found }' "$MOUNTINFO"; then
			return 0
		fi
		case $(blkid "/dev/$v" 2>/dev/null) in
		*'LABEL="SIONBOOT"'*|*'LABEL="SIONDATA"'*|*'LABEL="XBOXBOOT"'*|*'LABEL="XBOXDATA"'*) return 0 ;;
		esac
	done
	return 1
}

removable() {
	case $(readlink -f "$SYS/$1") in
	*/usb[0-9]*|*/mmc[0-9]*) return 0 ;;
	esac
	return 1
}

# A reader can remain in sysfs with no card (size zero). diskseq also
# distinguishes media replacement while the /dev name stays the same.
identity() {
	path=$(readlink -f "$SYS/$1") || return 1
	[ -d "$path" ] || return 1
	size=$(cat "$path/size" 2>/dev/null)
	[ -n "$size" ] && [ "$size" != 0 ] || return 1
	if [ -e "$path/partition" ]; then path=${path%/*}; fi
	parent_size=$(cat "$path/size" 2>/dev/null)
	[ -n "$parent_size" ] && [ "$parent_size" != 0 ] || return 1
	seq=$(cat "$path/diskseq" 2>/dev/null)
	num=$(cat "$SYS/$1/dev" 2>/dev/null)
	printf '%s:%s:%s:%s\n' "$num" "${seq:-0}" "$size" "$parent_size"
}

mounted() { awk -v dev="/dev/$1" '$1 == dev { found=1 } END { exit !found }' "$MOUNTS"; }

poll_cards() {
	# A failed mount must not suppress a later card in the same reader.
	for f in "$STATE"/*.failed; do
		[ -f "$f" ] || continue
		name=${f##*/}; name=${name%.failed}
		new=$(identity "$name") || new=
		[ -n "$new" ] && [ "$new" = "$(head -n 1 "$f")" ] || rm -f "$f"
	done
	removed=" "
	while read -r dev mnt rest; do
		name=${dev##*/}
		[ "$dev" = "/dev/$name" ] && [ "$mnt" = "$MEDIA/$name" ] || continue
		new=$(identity "$name") || new=
		old=$(cat "$STATE/$name.mounted" 2>/dev/null)
		if [ -n "$new" ] && { [ -z "$old" ] || [ "$new" = "$old" ]; }; then
			printf '%s\n' "$new" > "$STATE/$name.mounted"
			continue
		fi
		if umount -l "$mnt"; then
			rmdir "$mnt" 2>/dev/null
			rm -f "$STATE/$name.mounted" "$STATE/$name.failed"
			log "card: $name removed or replaced"
			# Leave a full poll interval empty so the Dashboard sees a swap,
			# including two cards with identical cart filenames.
			removed="$removed$name "
		fi
	done < "$MOUNTS"

	for d in "$SYS"/*; do
		disk=${d##*/}
		[ -e "$d/partition" ] && continue
		case $disk in sr*) continue ;; esac
		removable "$disk" || continue
		identity "$disk" > /dev/null || continue
		system_disk "$disk" && continue
		for v in $(volumes "$disk"); do
			# A replacement may receive a different /dev name. Defer all
			# new mounts for this pass after removing any old card.
			[ "$removed" != " " ] && continue
			mounted "$v" && continue
			id=$(identity "$v") || continue
			if [ "$(head -n 1 "$STATE/$v.failed" 2>/dev/null)" = "$id" ]; then
				retry=$(sed -n '2p' "$STATE/$v.failed")
				case $retry in ''|*[!0-9]*) retry=0 ;; esac
				if [ "$retry" -gt 0 ]; then
					printf '%s\n%s\n' "$id" "$((retry - 1))" > "$STATE/$v.failed"
					continue
				fi
			fi
			m=$MEDIA/$v
			mkdir -p "$m"
			# BusyBox blkid lacks -s/-o and may omit TYPE. Let mount probe
			# installed filesystem drivers, always requesting read-only.
			if mount -o ro,noatime "/dev/$v" "$m"; then
				printf '%s\n' "$id" > "$STATE/$v.mounted"
				rm -f "$STATE/$v.failed"
				log "card: mounted /dev/$v on $m (read-only)"
			else
				rmdir "$m" 2>/dev/null
				printf '%s\n4\n' "$id" > "$STATE/$v.failed"
				log "card: /dev/$v could not be mounted; retrying after delay or media change"
			fi
		done
	done
}

case $1 in
--daemon)
	running && exit 0
	if command -v setsid > /dev/null; then
		setsid "$0" --run > /dev/null 2>&1 < /dev/null &
	else
		"$0" --run > /dev/null 2>&1 < /dev/null &
	fi
	echo $! > "$PIDFILE"
	exit 0 ;;
--run|--once) ;;
*)
	running && { echo "sion-cards is already running"; exit 0; }
	echo $$ > "$PIDFILE" ;;
esac
mkdir -p "$MEDIA" "$STATE"
while :; do
	poll_cards
	[ "$1" = --once ] && exit 0
	sleep 2
done
