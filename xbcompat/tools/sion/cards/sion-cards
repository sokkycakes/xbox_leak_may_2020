#!/bin/sh
#
# Game cards on the Sion: every other USB stick or SD card is mounted
# read-only at /media/<device>, the way Kazeta finds carts, and unmounted
# when it's pulled. xbcompat looks there for *.kzi/*.kzp (its CARD0: drive),
# and the dashboard's Games list follows within a second or two.
#
# Read-only, so pulling a card never damages it; saves and installed games
# go to /data. The boot stick and internal disks are left alone.
#
#   sion-cards           run in the foreground
#   sion-cards --daemon  start in the background unless already running
#

. /usr/lib/sion/sion-lib.sh

MEDIA=/media
PIDFILE=/var/run/sion-cards.pid
FAILED=$SION_RUN/cards-failed

running() {
	[ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case $1 in
--daemon)
	running && exit 0
	if command -v setsid > /dev/null; then
		setsid "$0" --run > /dev/null 2>&1 < /dev/null &
	else
		"$0" --run > /dev/null 2>&1 < /dev/null &
	fi
	echo $! > "$PIDFILE"
	exit 0
	;;
--run) ;;
*)
	running && { echo "sion-cards is already running"; exit 0; }
	echo $$ > "$PIDFILE"
	;;
esac

esp=$(find_esp)
boot=
[ -n "$esp" ] && boot=$(part_disk "$esp")

# The boot stick, found by its labels too, in case the EFI lookup failed:
# its partitions are mounted read-write elsewhere.
boot_disk() {
	[ "/dev/$1" = "$boot" ] && return 0
	for v in $(volumes "$1"); do
		case $(fs_label "/dev/$v") in SIONBOOT|SIONDATA) return 0 ;; esac
	done
	return 1
}

mounted() {
	grep -q "^/dev/$1 " /proc/mounts
}

# USB and SD devices only: an internal SATA or NVMe disk is never a card.
removable() {
	case $(readlink -f "/sys/class/block/$1") in
	*/usb[0-9]*|*/mmc[0-9]*) return 0 ;;
	esac
	return 1
}

# The partitions of a card, or the whole device when it has none (sticks
# formatted without a partition table).
volumes() {
	parts=
	for p in "/sys/class/block/$1/$1"*; do
		[ -e "$p/partition" ] && parts="$parts ${p##*/}"
	done
	echo "${parts:-$1}"
}

try_mount() {
	dev=$1
	grep -qx "$dev" "$FAILED" 2>/dev/null && return 1
	type=$(blkid -s TYPE -o value "/dev/$dev" 2>/dev/null)
	m=$MEDIA/$dev
	mkdir -p "$m"
	case $type in
	vfat) mount -t vfat -o ro,noatime,utf8 "/dev/$dev" "$m" 2>/dev/null ||
		mount -t vfat -o ro,noatime "/dev/$dev" "$m" 2>/dev/null ;;
	ext2|ext3|ext4|iso9660|udf) mount -t "$type" -o ro,noatime "/dev/$dev" "$m" 2>/dev/null ;;
	*) false ;;
	esac
	if [ $? -eq 0 ]; then
		log "card: mounted /dev/$dev ($type) on $m"
	else
		rmdir "$m" 2>/dev/null
		echo "$dev" >> "$FAILED"
		case $type in
		exfat) log "card: /dev/$dev is exFAT, which this system can't read yet; format it FAT32" ;;
		*) log "card: /dev/$dev (${type:-no filesystem}) can't be mounted" ;;
		esac
	fi
}

mkdir -p "$MEDIA"
: > "$FAILED"
while true; do
	# Pulled cards: drop their mounts (lazily, in case a game still has a
	# file open) and forget earlier failures for them.
	while read -r dev mnt _; do
		case $mnt in "$MEDIA"/*) ;; *) continue ;; esac
		[ -e "/sys/class/block/${dev##*/}" ] && continue
		umount -l "$mnt" 2>/dev/null
		rmdir "$mnt" 2>/dev/null
		log "card: ${dev##*/} removed"
	done < /proc/mounts
	if [ -s "$FAILED" ]; then
		while read -r dev; do
			[ -e "/sys/class/block/$dev" ] && echo "$dev"
		done < "$FAILED" > "$FAILED.new"
		mv "$FAILED.new" "$FAILED"
	fi

	for d in /sys/class/block/*; do
		disk=${d##*/}
		[ -e "$d/partition" ] && continue
		removable "$disk" || continue
		boot_disk "$disk" && continue
		# A card reader with no card in it reports size 0.
		[ "$(cat "$d/size" 2>/dev/null)" != 0 ] || continue
		for v in $(volumes "$disk"); do
			mounted "$v" || try_mount "$v"
		done
	done
	sleep 2
done
