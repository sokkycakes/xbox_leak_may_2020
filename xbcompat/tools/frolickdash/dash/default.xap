//
// Frolick for the Xbox dashboard engine: the hub.  Generated by
// tools/genhub.py from frolick_assets/main.tscn.
//

DEF theScreen Screen
{
    width 640
    height 480
}

NavigationInfo
{
    type "sample"
    headlight false
    avatarSize 0.1 1.6 0.75
}

DEF theBackground Background
{
    skyColor 0.039 0.039 0.059
    backdrop XtxTexture { url "backdrop.xtx" }
}

// The library pad's camera loads first, so the dashboard opens on it.
DEF vpLibrary Viewpoint
{
    fieldOfView 1.39626
    position 0.00000 0.10656 0.91758
    orientation -1.0000 0.0000 -0.0000 -0.3850
}

DEF vpCatalog Viewpoint
{
    fieldOfView 1.39941
    position -0.84822 0.10740 0.46469
    orientation -0.4399 0.8815 0.1718 -0.8341
}

DEF vpSettings Viewpoint
{
    fieldOfView 1.39941
    position 0.84822 0.10740 0.46469
    orientation -0.4399 -0.8815 -0.1718 -0.8341
}

DEF theMover CameraMover
{
    duration 0.55
    function OnArrive()
    {
        bMoving = false;
    }
}

var nPad;       // 0 catalog, 1 library, 2 settings
var bMoving;

DEF theHub Level
{
    children
    [
        // world3D/bg: the atmo dome, multiplied over the backdrop, and the
        // rail ribbon that circles the scene above and behind the pads.
        Transform
        {
            translation 0.00000 -2.12831 -4.93449
            children [ Dome { radius 6.96917 height 4.26285 } ]
        }
        Transform
        {
            translation -0.20688 2.13097 -4.21954
            children [ Ribbon { radius 5.91860 height 1.81538 color 0.58700 0.56900 0.44100 } ]
        }

        // world3D/nav: the pads
        // catalog: the pad disc, its bumper and what floats over it
        Transform
        {
            translation -0.78017 -0.04273 -0.12950
            children [ Disc { radius 0.27628 color 0.24940 0.50382 0.86000 } ]
        }
        Transform
        {
            translation -0.78017 -0.02892 -0.12950
            children [ Ribbon { radius 0.28666 height 0.00396 color 0.58700 0.56900 0.44100 inner true innerColor 0.78516 0.77488 0.69118 } ]
        }
        Transform
        {
            translation -0.78017 0.07174 -0.12950
            children [ Sprite { url "circle.xtx" pixelSize 0.000658 color 0.25098 0.50196 0.85882 } ]
        }
        Transform
        {
            translation -0.78225 0.07750 -0.13592
            children [ Sprite { url "circle.xtx" pixelSize 0.000443 color 0.25098 0.50196 0.85882 } ]
        }
        Transform
        {
            translation -0.78225 0.07976 -0.14806
            children [ Sprite { url "circle.xtx" pixelSize 0.000323 color 0.25098 0.50196 0.85882 } ]
        }
        Transform
        {
            translation -0.78017 0.02091 -0.12950
            children [ Sprite { url "label_catalog.xtx" pixelSize 0.000553 depthTest false } ]
        }
        // library: the pad disc, its bumper and what floats over it
        Transform
        {
            translation -0.00028 -0.04290 0.28679
            children [ Disc { radius 0.27628 color 0.54002 0.78000 0.22620 } ]
        }
        Transform
        {
            translation -0.00028 -0.04589 0.28679
            children [ Disc { radius 0.28944 innerRadius 0.28140 color 0.54002 0.78000 0.22620 } ]
        }
        Transform
        {
            translation -0.00028 -0.02908 0.28679
            children [ Ribbon { radius 0.28666 height 0.00396 color 0.58700 0.56900 0.44100 inner true innerColor 0.78516 0.77488 0.69118 } ]
        }
        Transform
        {
            translation -0.00028 -0.05888 0.28679
            children [ Sprite { url "circle.xtx" pixelSize 0.000658 color 0.53726 0.77255 0.22353 } ]
        }
        Transform
        {
            translation -0.00236 -0.05313 0.28037
            children [ Sprite { url "circle.xtx" pixelSize 0.000443 color 0.53726 0.77255 0.22353 } ]
        }
        Transform
        {
            translation -0.00236 -0.05087 0.26823
            children [ Sprite { url "circle.xtx" pixelSize 0.000323 color 0.53726 0.77255 0.22353 } ]
        }
        Transform
        {
            translation -0.00028 0.02074 0.28679
            children [ Sprite { url "label_library.xtx" pixelSize 0.000553 depthTest false } ]
        }
        // settings: the pad disc, its bumper and what floats over it
        Transform
        {
            translation 0.78051 -0.04273 -0.12920
            children [ Disc { radius 0.27628 color 0.85000 0.54353 0.24650 } ]
        }
        Transform
        {
            translation 0.78051 -0.02892 -0.12920
            children [ Ribbon { radius 0.28666 height 0.00396 color 0.58700 0.56900 0.44100 inner true innerColor 0.78516 0.77488 0.69118 } ]
        }
        Transform
        {
            translation 0.78051 0.07174 -0.12920
            children [ Sprite { url "circle.xtx" pixelSize 0.000658 color 0.79608 0.49804 0.22745 } ]
        }
        Transform
        {
            translation 0.77843 0.07750 -0.13562
            children [ Sprite { url "circle.xtx" pixelSize 0.000443 color 0.79608 0.49804 0.22745 } ]
        }
        Transform
        {
            translation 0.77843 0.07976 -0.14776
            children [ Sprite { url "circle.xtx" pixelSize 0.000323 color 0.79608 0.49804 0.22745 } ]
        }
        Transform
        {
            translation 0.78051 0.02091 -0.12920
            children [ Sprite { url "label_settings.xtx" pixelSize 0.000553 depthTest false } ]
        }

        // Each pad's panel faces its camera, faded in and out by its Transform.
        DEF xfCatalog Transform
        {
            fade 0.55
            alpha 0
            children
            [
                DEF padCatalog XuiPanel
                {
                    url "pads/catalog.xui"
                    skin "pads/frolick_skin.xui"
                    origin -0.92516 0.57084 -0.11581
                    axisX 0.66179 0.00000 0.60995
                    axisY 0.07407 -0.43652 -0.08037
                    function OnPress(id) { OnPadPress(0, id); }
                }
            ]
        }
        DEF xfLibrary Transform
        {
            fade 0.55
            alpha 1
            children
            [
                DEF padLibrary XuiPanel
                {
                    url "pads/library.xui"
                    skin "pads/frolick_skin.xui"
                    origin -0.45000 0.57000 0.54288
                    axisX 0.90000 -0.00000 0.00000
                    axisY -0.00000 -0.43652 -0.10930
                    function OnPress(id) { OnPadPress(1, id); }
                }
            ]
        }
        DEF xfSettings Transform
        {
            fade 0.55
            alpha 0
            children
            [
                DEF padSettings XuiPanel
                {
                    url "pads/settings.xui"
                    skin "pads/frolick_skin.xui"
                    origin 0.26338 0.57084 0.49414
                    axisX 0.66179 -0.00000 -0.60995
                    axisY -0.07407 -0.43652 -0.08037
                    function OnPress(id) { OnPadPress(2, id); }
                }
            ]
        }

        // appUILayer: the word behind the view, the A prompt, the footer.
        HUD
        {
            children
            [
                DEF theOverlay XuiPanel
                {
                    url "pads/overlay.xui"
                    width 720
                }
            ]
        }
    ]

    control DEF theJoystick Joystick
    {
        function OnMoveLeft() { PadMove("left", -1); }
        function OnMoveRight() { PadMove("right", 1); }
        function OnMoveUp() { PadMove("up", 0); }
        function OnMoveDown() { PadMove("down", 0); }
        function OnADown() { PadPress(); }
    }
}

// Focus moves inside the panel first; at its edge, left and right fly to
// the next pad, as in Frolick.
function PadMove(dir, step)
{
    if (bMoving)
        return;

    var moved = 0;
    if (nPad == 0)
        moved = padCatalog.Navigate(dir);
    else if (nPad == 1)
        moved = padLibrary.Navigate(dir);
    else
        moved = padSettings.Navigate(dir);

    if (moved == 0)
    {
        var n = nPad + step;
        if (n >= 0)
        {
            if (n <= 2)
            {
                if (n != nPad)
                    GoPad(n);
            }
        }
    }
}

function PadPress()
{
    if (bMoving)
        return;

    if (nPad == 0)
        padCatalog.Press();
    else if (nPad == 1)
        padLibrary.Press();
    else
        padSettings.Press();
}

function OnPadPress(pad, id)
{
    // Frolick: A on the library pad opens the game carousel.
}

function SetPadAlpha(pad, a)
{
    if (pad == 0)
        xfCatalog.SetAlpha(a);
    else if (pad == 1)
        xfLibrary.SetAlpha(a);
    else
        xfSettings.SetAlpha(a);
}

function GoPad(n)
{
    bMoving = true;
    SetPadAlpha(nPad, 0);
    nPad = n;
    SetPadAlpha(nPad, 1);

    if (n == 0)
    {
        theMover.GoTo(vpCatalog);
        padCatalog.Play("", "Intro");
        theOverlay.SetText("word", "discover");
    }
    else if (n == 1)
    {
        theMover.GoTo(vpLibrary);
        padLibrary.Play("", "Intro");
        theOverlay.SetText("word", "play");
    }
    else
    {
        theMover.GoTo(vpSettings);
        padSettings.Play("", "Intro");
        theOverlay.SetText("word", "");
    }
}

function initialize()
{
    nPad = 1;
    bMoving = false;
    EnableInput(true);
    theHub.GoTo();
    padLibrary.Play("", "Intro");
    theOverlay.SetText("word", "play");
}
