#!/bin/sh
#
# Runs the Xbox dashboard (xboxdash.xbe under xbcompat) once the boot
# animation is done, and again whenever it exits. A game the dashboard
# starts replaces it in the same process (XLaunchNewImage), so quitting the
# game lands back here and the dashboard comes back, as the Xbox rebooted
# into it. If the dashboard itself keeps failing to start, Theseus takes
# over for the rest of this boot.
#

BOOTANI_PIDFILE=/var/run/bootani.pid
LOG=/var/log/xbox.log
FAILED=/var/run/xbox/dash-failed

. /usr/lib/xbox/xbox-env
# XBOX_ARGS: more xbcompat options for the dashboard (e.g. --trace).
# shellcheck source=/dev/null
[ -r /etc/default/xbox ] && . /etc/default/xbox

# The boot animation owns the display until its last frame; KMS allows one
# master.
if [ -r "$BOOTANI_PIDFILE" ]; then
	pid=$(cat "$BOOTANI_PIDFILE")
	while [ -n "$pid" ] && [ -d "/proc/$pid" ]; do
		sleep 0.1
	done
fi

# The Xbox's hard disk, kept on /data when there is one:
#   partition1  E: saves (UDATA, TDATA) and installed games (E:\Games)
#   partition2  C: the dashboard: a link to the image's copy, so an image
#               update brings its dashboard along (one link for the whole
#               partition; with a link per file the dashboard crashes)
#   partition3-5  X: Y: Z: title caches
# The DVD drive (D: for the dashboard) is $XB/disc: put an extracted game
# disc there; empty is an empty tray.
if mountpoint -q /data; then
	XB=/data/xbox
else
	XB=/var/run/xbox/data
	echo "no /data: the Xbox hard disk is in RAM and lasts until reboot"
fi
HDD=$XB/hdd
for p in 1 3 4 5; do mkdir -p "$HDD/partition$p"; done
mkdir -p "$HDD/partition1/Games" "$XB/disc" "$XB/cache/xbcompat" /var/run/xbox
if [ -d "$HDD/partition2" ] && [ ! -L "$HDD/partition2" ]; then
	mv "$HDD/partition2" "$HDD/partition2.old.$$"
fi
ln -sfn "$X/dash" "$HDD/partition2"
# Signatures for XDK 4400 titles, made at bundle time from the leak's
# libraries; the maps xbrun.py makes for other titles land beside them.
for f in "$X"/cache/xbcompat/*.json; do
	[ -e "$XB/cache/xbcompat/${f##*/}" ] || cp "$f" "$XB/cache/xbcompat/"
done
export XDG_CACHE_HOME=$XB/cache

# KMS allows one master: wait for anything else on the display (Theseus,
# when "sion restart xbox" takes over from it) to be gone.
for _ in $(seq 1 50); do
	pidof theseus > /dev/null || break
	sleep 0.2
done
killall -q -9 theseus

# XBOX_DASH=devkit (/etc/default/xbox): the devkit dashboard
# (xbcompat/tools/devkitdash, in C:\devkit) runs in the dashboard's place.
# xboxdash.xbe stays where it is: the devkit dashboard lists it, and asking
# for it (E:\DEVKIT\run-xboxdash) runs it here once; a game it starts
# comes back to the devkit dashboard when it quits.  A game quitting to the
# dashboard with launch data gets the stock dashboard too.  xbox-hostinfo
# keeps E:\DEVKIT\hostinfo.txt current, and xbox-bluetooth serves the
# Settings page (E:\DEVKIT\BT).  (This is the devkit kit's session for
# images from before XBOX_DASH, xbox-session.oldimage.)
DEVKIT=$X/dash/devkit
devkit=
if [ "$XBOX_DASH" = devkit ]; then
	if [ -f "$DEVKIT/devkitdash.xbe" ] && [ -f "$DEVKIT/devkitdash.map" ]; then
		devkit=1
		mkdir -p "$HDD/partition1/DEVKIT"
		for h in hostinfo bluetooth; do
			f=/usr/libexec/xbox-$h
			[ -x "$f" ] || f="$DEVKIT/xbox-$h"
			[ -f "$f" ] || continue
			if [ $h = hostinfo ]; then
				sh "$f" "$HDD/partition1/DEVKIT/hostinfo.txt" 5 $$ < /dev/null > /dev/null 2>&1 &
			else
				sh "$f" "$HDD/partition1/DEVKIT/BT" $$ < /dev/null > /dev/null 2>&1 &
			fi
		done
	else
		echo "XBOX_DASH=devkit, but $DEVKIT/devkitdash.xbe is missing: running the Xbox dashboard"
	fi
fi

quick_fails=0
while true; do
	# Launch data a game left for the dashboard (XLaunchNewImage(NULL, data)).
	launch=
	if [ -s "$HDD/.dashlaunch" ]; then
		mv "$HDD/.dashlaunch" /var/run/xbox/dashlaunch
		launch="--launch-data /var/run/xbox/dashlaunch"
	fi
	[ -e "$LOG" ] && mv "$LOG" "$LOG.1"
	start=$(cut -d. -f1 /proc/uptime)
	stock=1
	if [ -n "$devkit" ]; then
		stock=
		if [ -e "$HDD/partition1/DEVKIT/run-xboxdash" ]; then
			rm -f "$HDD/partition1/DEVKIT/run-xboxdash"
			stock=1
		fi
		# Only launch data meant for the dashboard (LDT_LAUNCH_DASHBOARD, 1:
		# a game's "open the Memory screen") goes to the stock one; a game
		# that just quits leaves LDT_NONE (ffffffff) and comes back here.
		if [ -n "$launch" ]; then
			if [ "$(od -An -tx1 -N4 /var/run/xbox/dashlaunch 2>/dev/null | tr -d ' \n')" = 01000000 ]; then
				stock=1
			else
				launch=
			fi
		fi
	fi
	if [ -n "$stock" ]; then
		echo "$(date '+%F %T') starting the dashboard${launch:+ with launch data}"
		# shellcheck disable=SC2086
		"$X/bin/xbcompat" --hle "$X/dash/xboxdash.map" --hdd "$HDD" --dvd "$XB/disc" \
			--d-path '\Device\CdRom0' --xbe-path xboxdash.xbe $launch $XBOX_ARGS \
			"$HDD/partition2/xboxdash.xbe" > "$LOG" 2>&1
	else
		echo "$(date '+%F %T') starting the devkit dashboard"
		# shellcheck disable=SC2086
		"$X/bin/xbcompat" --hle "$DEVKIT/devkitdash.map" --hdd "$HDD" --dvd "$XB/disc" \
			--d-path '\Device\Harddisk0\Partition2\devkit' --xbe-path devkitdash.xbe $XBOX_ARGS \
			"$HDD/partition2/devkit/devkitdash.xbe" > "$LOG" 2>&1
	fi
	rc=$?
	ran=$(( $(cut -d. -f1 /proc/uptime) - start ))
	echo "$(date '+%F %T') exited with $rc after ${ran}s"
	if grep -q 'XLaunchNewImage:' "$LOG"; then
		quick_fails=0          # a game ran and quit
	elif [ -e "$HDD/partition1/DEVKIT/run-xboxdash" ]; then
		quick_fails=0          # the devkit dashboard asked for the Xbox one
	elif [ "$ran" -lt 20 ]; then
		quick_fails=$((quick_fails + 1))
		if [ "$quick_fails" -ge 3 ]; then
			echo "the dashboard failed to start 3 times; starting Theseus (log: $LOG)"
			touch "$FAILED"
			[ -x /etc/init.d/S99theseus ] && /etc/init.d/S99theseus start
			exit 1
		fi
	else
		quick_fails=0
	fi
	sleep 2
done
