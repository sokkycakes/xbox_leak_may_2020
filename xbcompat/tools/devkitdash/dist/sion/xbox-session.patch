+				--d-path '\Device\Harddisk0\Partition2\devkit' --xbe-path devkitdash.xbe \
+				$XBOX_SHOT_ARGS $XBOX_ARGS > "$LOG" 2>&1
+		fi
+	fi
 	rc=$?
 	ran=$(( $(cut -d. -f1 /proc/uptime) - start ))
