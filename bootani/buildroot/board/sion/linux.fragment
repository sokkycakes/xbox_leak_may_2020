# Acer Chromebox CXI3 ("sion", Kaby Lake, Intel UHD 620)
CONFIG_DRM_I915=y
CONFIG_SND_HDA_I915=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_CMDLINE_BOOL=y
# Legacy HD Audio driver for the HDMI output (the headphone jack is on an I2S
# codec that needs the audio DSP, which this image leaves out).
CONFIG_CMDLINE="console=tty1 quiet loglevel=3 snd_intel_dspcfg.dsp_driver=1 i915.fastboot=1"
