+void my_box86signalhandler(int32_t sig, siginfo_t* info, void * ucntx);
+// A native library (SDL's evdev keyboard code) may have taken one of these
+// over, and re-raises what it catches, hiding the real fault and breaking
+// the dynarec's own SIGSEGV use: take it back when the x86 side sets one.
+static void reinstall_box86_handler(int signum)
+{
+    struct sigaction action = {0};
+    action.sa_flags = SA_SIGINFO | SA_RESTART | SA_NODEFER;
+    action.sa_sigaction = my_box86signalhandler;
+    sigaction(signum, &action, NULL);
+}
+
 void my_box86signalhandler(int32_t sig, siginfo_t* info, void * ucntx)
 {
     // sig==SIGSEGV || sig==SIGBUS || sig==SIGILL here!
@@ -1162,8 +1175,10 @@ EXPORT sighandler_t my_signal(x86emu_t* emu, int signum, sighandler_t handler)
