diff --git a/theseus/desktop/sdl_main.cpp b/theseus/desktop/sdl_main.cpp
index 7ca83f7..3b5a527 100644
--- a/theseus/desktop/sdl_main.cpp
+++ b/theseus/desktop/sdl_main.cpp
@@ -201,6 +201,12 @@ VirtualGameDB g_vgames = {};
 
 // Global SDL/GL state; used by D3D8 stubs to render
 SDL_Window*   g_pSDLWindow = NULL;
+
+// KMSDRM (no X11 or Wayland): SDL owns the display and a GL context on a GBM
+// surface, and bgfx renders into that context with its OpenGL backend.
+// Presenting is then SDL_GL_SwapWindow, which also does the KMS page flip.
+bool          g_kmsdrm = false;
+static SDL_GLContext s_kmsGLContext = NULL;
 SDL_GLContext  g_pGLContext = NULL;
 GLState        g_gl = {};
 
@@ -728,7 +734,19 @@ unsigned long long GuiTextureImId(const GuiTexture* tex) {
 
 // Forward declarations for PreSwapOverlays
 bool g_debugMode = false;
-void Plat_GetDrawableSize(int* w, int* h)
+// Fixed scene size (KMSDRM only, THESEUS_SCENE=WxH, e.g. 640x480). The
+// Xbox dashboard drew into a 640x480 back buffer whatever the TV, and the
+// video encoder stretched that across the 720x480 NTSC signal. Here the
+// whole frame (scene, CRT pass, ImGui) goes into an offscreen target of
+// that size, and Plat_Present stretches it over the display mode. Every
+// size query below Plat_GetDrawableSize sees the scene size.
+static int s_sceneW = 0, s_sceneH = 0;
+bgfx::FrameBufferHandle g_sceneFB = BGFX_INVALID_HANDLE;
+static bgfx::TextureHandle s_sceneTex = BGFX_INVALID_HANDLE;
+static const bgfx::ViewId kSceneBlitView = 250;
+
+// The real size of the output, whatever the scene size.
+void Plat_GetOutputSize(int* w, int* h)
 {
     if (w) *w = 0;
     if (h) *h = 0;
@@ -736,11 +754,108 @@ void Plat_GetDrawableSize(int* w, int* h)
     SDL_GetWindowSizeInPixels(g_pSDLWindow, w, h);
 }
 
+void Plat_GetDrawableSize(int* w, int* h)
+{
+    if (s_sceneW > 0) {
+        if (w) *w = s_sceneW;
+        if (h) *h = s_sceneH;
+        return;
+    }
+    Plat_GetOutputSize(w, h);
+}
+
+// (Re)creates the scene target and points the scene and ImGui views at it.
+// rtFlags is BGFX_TEXTURE_RT or one of the BGFX_TEXTURE_RT_MSAA_X* modes.
+static void Scene_ApplyTarget(uint64_t rtFlags)
+{
+    uint64_t msaaFlags = rtFlags;
+    if (s_sceneW <= 0) return;
+    static uint64_t s_flags = ~0ull;
+    if (!bgfx::isValid(g_sceneFB) || s_flags != msaaFlags) {
+        if (bgfx::isValid(g_sceneFB)) bgfx::destroy(g_sceneFB);
+        bgfx::TextureHandle att[2];
+        att[0] = bgfx::createTexture2D((uint16_t)s_sceneW, (uint16_t)s_sceneH, false, 1,
+                                       bgfx::TextureFormat::BGRA8,
+                                       msaaFlags |
+                                       BGFX_SAMPLER_U_CLAMP | BGFX_SAMPLER_V_CLAMP);
+        att[1] = bgfx::createTexture2D((uint16_t)s_sceneW, (uint16_t)s_sceneH, false, 1,
+                                       bgfx::TextureFormat::D24S8,
+                                       BGFX_TEXTURE_RT_WRITE_ONLY | msaaFlags);
+        g_sceneFB = bgfx::createFrameBuffer(2, att, true);
+        s_sceneTex = att[0];
+        s_flags = msaaFlags;
+    }
+    bgfx::setViewFrameBuffer(0, g_sceneFB);
+    bgfx::setViewFrameBuffer(2, g_sceneFB);
+}
+
+// Stretches the scene target over the whole output (bilinear, like the
+// Xbox's encoder scaling 640 pixels across the 720-wide signal).
+static void Scene_BlitToOutput()
+{
+    extern bgfx::ProgramHandle g_bgfxProgBlit;
+    extern bgfx::UniformHandle g_bgfxSamplerBlit;
+    if (!bgfx::isValid(g_sceneFB) || !bgfx::isValid(g_bgfxProgBlit)) return;
+    int ow = 0, oh = 0;
+    Plat_GetOutputSize(&ow, &oh);
+    bgfx::setViewFrameBuffer(kSceneBlitView, BGFX_INVALID_HANDLE);
+    bgfx::setViewRect(kSceneBlitView, 0, 0, (uint16_t)ow, (uint16_t)oh);
+    bgfx::setViewClear(kSceneBlitView, 0);
+
+    // Same layout as the CRT pass (vs_blit's inputs). The target was drawn
+    // by GL with its origin at the bottom, so the bottom of the quad samples
+    // V=0.
+    bgfx::VertexLayout layout;
+    layout.begin()
+        .add(bgfx::Attrib::Position,  3, bgfx::AttribType::Float)
+        .add(bgfx::Attrib::Normal,    3, bgfx::AttribType::Float)
+        .add(bgfx::Attrib::Color0,    4, bgfx::AttribType::Uint8, true)
+        .add(bgfx::Attrib::Color1,    4, bgfx::AttribType::Uint8, true)
+        .add(bgfx::Attrib::TexCoord0, 2, bgfx::AttribType::Float)
+        .end();
+    struct V { float px, py, pz, nx, ny, nz; uint32_t c0, c1; float u, v; };
+    const uint32_t white = 0xffffffff;
+    V verts[4] = {
+        { -1.f, -1.f, 0.f, 0,0,0, white,white, 0.f, 0.f },
+        {  1.f, -1.f, 0.f, 0,0,0, white,white, 1.f, 0.f },
+        {  1.f,  1.f, 0.f, 0,0,0, white,white, 1.f, 1.f },
+        { -1.f,  1.f, 0.f, 0,0,0, white,white, 0.f, 1.f },
+    };
+    const uint16_t idx[6] = { 0, 1, 2, 0, 2, 3 };
+    bgfx::TransientVertexBuffer tvb;
+    bgfx::TransientIndexBuffer  tib;
+    if (bgfx::getAvailTransientVertexBuffer(4, layout) < 4) return;
+    if (bgfx::getAvailTransientIndexBuffer(6) < 6)            return;
+    bgfx::allocTransientVertexBuffer(&tvb, 4, layout);
+    memcpy(tvb.data, verts, sizeof(verts));
+    bgfx::allocTransientIndexBuffer(&tib, 6);
+    memcpy(tib.data, idx, sizeof(idx));
+    bgfx::setTexture(0, g_bgfxSamplerBlit, s_sceneTex);
+    bgfx::setState(BGFX_STATE_WRITE_RGB | BGFX_STATE_WRITE_A);
+    bgfx::setVertexBuffer(0, &tvb, 0, 4);
+    bgfx::setIndexBuffer(&tib, 0, 6);
+    bgfx::submit(kSceneBlitView, g_bgfxProgBlit);
+}
+
+void Plat_Present(void)
+{
+    Scene_BlitToOutput();
+    bgfx::frame();
+    if (g_kmsdrm && g_pSDLWindow)
+        SDL_GL_SwapWindow(g_pSDLWindow);
+}
+
 void Plat_GetWindowSize(int* w, int* h)
 {
     if (w) *w = 0;
     if (h) *h = 0;
     if (!g_pSDLWindow) return;
+    if (s_sceneW > 0) {
+        // The scene is the screen, at a display scale of 1.
+        if (w) *w = s_sceneW;
+        if (h) *h = s_sceneH;
+        return;
+    }
     SDL_GetWindowSize(g_pSDLWindow, w, h);
 }
 
@@ -832,6 +947,19 @@ static void PreSwapOverlays() {
     Gfx_ReconcileDrawable();
 
     ImGui_ImplSDL2_NewFrame();
+    if (s_sceneW > 0) {
+        // ImGui draws into the scene target too, so lay it out at the scene
+        // size and map the pointer into it.
+        ImGuiIO& sio = ImGui::GetIO();
+        int ww = 0, wh = 0;
+        SDL_GetWindowSize(g_pSDLWindow, &ww, &wh);
+        if (ww > 0 && wh > 0 && sio.MousePos.x != -FLT_MAX) {
+            sio.MousePos.x *= (float)s_sceneW / ww;
+            sio.MousePos.y *= (float)s_sceneH / wh;
+        }
+        sio.DisplaySize = ImVec2((float)s_sceneW, (float)s_sceneH);
+        sio.DisplayFramebufferScale = ImVec2(1.0f, 1.0f);
+    }
     ImGui::NewFrame();
 
     // Pointer gets out of the way: always in pad mode, otherwise after a few
@@ -1082,10 +1210,19 @@ static uint32_t BgfxResetFlags() {
 // fullscreen hiccup.
 static void BgfxApplyReset() {
     if (!g_pSDLWindow) return;
-    int w = 0, h = 0;
+    int w = 0, h = 0, ow = 0, oh = 0;
     Plat_GetDrawableSize(&w, &h);
-    if (w <= 0 || h <= 0) return;
-    bgfx::reset((uint32_t)w, (uint32_t)h, BgfxResetFlags());
+    Plat_GetOutputSize(&ow, &oh);
+    if (w <= 0 || h <= 0 || ow <= 0 || oh <= 0) return;
+    if (s_sceneW > 0) {
+        // MSAA belongs on the scene target; the output only gets the blit.
+        bgfx::reset((uint32_t)ow, (uint32_t)oh, BgfxResetFlags() & ~BGFX_RESET_MSAA_MASK);
+        // RESET_MSAA_X2..X16 are 1..4; TEXTURE_RT..RT_MSAA_X16 are 1..5.
+        uint64_t msaa = (BgfxResetFlags() & BGFX_RESET_MSAA_MASK) >> BGFX_RESET_MSAA_SHIFT;
+        Scene_ApplyTarget((msaa + 1) << BGFX_TEXTURE_RT_SHIFT);
+    } else {
+        bgfx::reset((uint32_t)ow, (uint32_t)oh, BgfxResetFlags());
+    }
     bgfx::setViewRect(0, 0, 0, (uint16_t)w, (uint16_t)h);
     // ImGui lives on view 2 (sharp on top of any CRT pass on view 1).
     // bgfx skips views with no rect set, so size it to the backbuffer.
@@ -1102,6 +1239,13 @@ static void BgfxApplyReset() {
 void ApplyDisplayMode() {
     if (!g_pSDLWindow) return;
 
+    // On KMSDRM the window is the screen at its current mode; there is
+    // nothing to resize or toggle.
+    if (g_kmsdrm) {
+        BgfxApplyReset();
+        return;
+    }
+
     SDL_SetWindowFullscreen(g_pSDLWindow, 0);
 
     if (g_windowResolution > 0) {
@@ -1342,6 +1486,10 @@ int main(int argc, char* argv[]) {
     g_argv = argv;
     s_execPath = argv[0];
 
+    // Line-buffer the log when it goes to a file (the KMSDRM session's
+    // /var/log/theseus.log), so it is current when copied off the machine.
+    setvbuf(stdout, NULL, _IOLBF, 0);
+
 #ifdef _WIN32
     // /SUBSYSTEM:WINDOWS so explorer launches don't pop a console, but
     // attach to a parent shell when one exists so stdout/stderr show up.
@@ -1479,6 +1627,42 @@ int main(int argc, char* argv[]) {
     // macOS, Vulkan/D3D11 elsewhere), so no GL drawable flag.
     Uint32 windowFlags = SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI;
 
+    // KMSDRM has no native window for bgfx to attach to, so SDL creates the
+    // GL context (EGL on GBM) and bgfx borrows it. The vs/fs .bin shaders
+    // for bgfx's GL backend are GLSL 150, so ask for 3.3 core.
+    {
+        const char* vd = SDL_GetCurrentVideoDriver();
+        if (vd && SDL_strcasecmp(vd, "KMSDRM") == 0) {
+            g_kmsdrm = true;
+            const char* scene = SDL_getenv("THESEUS_SCENE");
+            if (scene && SDL_sscanf(scene, "%dx%d", &s_sceneW, &s_sceneH) != 2)
+                s_sceneW = s_sceneH = 0;
+            if (s_sceneW <= 0 || s_sceneH <= 0) s_sceneW = s_sceneH = 0;
+            if (s_sceneW > 0)
+                fprintf(stdout, "KMSDRM: scene %dx%d, stretched over the display mode\n",
+                        s_sceneW, s_sceneH);
+            // SDL insists on dlopen'ing a GL library before it uses EGL. A
+            // Mesa built without GLX has no libGL.so.1; every GL entry point
+            // still comes from eglGetProcAddress, so libEGL itself will do.
+            if (!SDL_getenv("SDL_VIDEO_GL_DRIVER"))
+                SDL_setenv("SDL_VIDEO_GL_DRIVER", "libEGL.so.1", 0);
+            SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
+            SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+            SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
+            SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+            SDL_GL_SetAttribute(SDL_GL_RED_SIZE, 8);
+            SDL_GL_SetAttribute(SDL_GL_GREEN_SIZE, 8);
+            SDL_GL_SetAttribute(SDL_GL_BLUE_SIZE, 8);
+            SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24);
+            SDL_GL_SetAttribute(SDL_GL_STENCIL_SIZE, 8);
+            // FULLSCREEN_DESKTOP keeps the mode the display is already in
+            // (the panel's or TV's preferred one) instead of picking the
+            // mode closest to the 1280x720 asked for below.
+            windowFlags = SDL_WINDOW_SHOWN | SDL_WINDOW_OPENGL | SDL_WINDOW_FULLSCREEN_DESKTOP;
+            fprintf(stdout, "KMSDRM: rendering through bgfx OpenGL on SDL's EGL context\n");
+        }
+    }
+
     g_pSDLWindow = SDL_CreateWindow(
         "UIX Desktop - Preview",
         SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
@@ -1492,6 +1676,19 @@ int main(int argc, char* argv[]) {
         return 1;
     }
 
+    if (g_kmsdrm) {
+        s_kmsGLContext = SDL_GL_CreateContext(g_pSDLWindow);
+        if (!s_kmsGLContext) {
+            fprintf(stderr, "SDL_GL_CreateContext failed: %s\n", SDL_GetError());
+            SDL_Quit();
+            return 1;
+        }
+        SDL_GL_MakeCurrent(g_pSDLWindow, s_kmsGLContext);
+        SDL_GL_SetSwapInterval(1);
+        // The pad and keyboard drive the dashboard; no pointer on a TV.
+        SDL_ShowCursor(SDL_DISABLE);
+    }
+
     // Window icon (TeamUIX logo, embedded).
     {
         int iw, ih, ich;
@@ -1516,6 +1713,14 @@ int main(int argc, char* argv[]) {
         } else {
             bgfx::PlatformData pd;
             std::memset(&pd, 0, sizeof(pd));
+            if (g_kmsdrm) {
+                // bgfx draws into SDL's current GL context and leaves the
+                // swap to us (Plat_Present). Calling renderFrame before init
+                // keeps bgfx single threaded, so the context stays current
+                // on this thread.
+                pd.context = s_kmsGLContext;
+                bgfx::renderFrame();
+            } else {
 #  if defined(__APPLE__)
             pd.nwh = wmi.info.cocoa.window;
 #  elif defined(_WIN32)
@@ -1524,16 +1729,23 @@ int main(int argc, char* argv[]) {
             // Branch on SDL's actual subsystem. Feeding x11 lanes to
             // bgfx on a Wayland session hands RADV a NULL Display and
             // it crashes in vkGetPhysicalDeviceSurfaceSupportKHR.
+            // An SDL built for KMSDRM only has neither union member.
+#    if defined(SDL_VIDEO_DRIVER_WAYLAND)
             if (wmi.subsystem == SDL_SYSWM_WAYLAND) {
                 pd.ndt  = wmi.info.wl.display;
                 pd.nwh  = wmi.info.wl.surface;
                 pd.type = bgfx::NativeWindowHandleType::Wayland;
-            } else {
+            } else
+#    endif
+            {
+#    if defined(SDL_VIDEO_DRIVER_X11)
                 pd.ndt  = wmi.info.x11.display;
                 pd.nwh  = (void*)(uintptr_t)wmi.info.x11.window;
                 pd.type = bgfx::NativeWindowHandleType::Default; // X11
+#    endif
             }
 #  endif
+            }
             bgfx::Init bgfxInit;
             bgfxInit.platformData       = pd;
             // Pixels, not points. On a HiDPI display the drawable is larger
@@ -1559,6 +1771,7 @@ int main(int argc, char* argv[]) {
                 case 5: bgfxInit.type = bgfx::RendererType::OpenGLES;   break;
                 default: bgfxInit.type = bgfx::RendererType::Count;     break;
             }
+            if (g_kmsdrm) bgfxInit.type = bgfx::RendererType::OpenGL;
