diff --git a/theseus/desktop/d3d8_sdl.h b/theseus/desktop/d3d8_sdl.h
index 452dae9..e05ec61 100644
--- a/theseus/desktop/d3d8_sdl.h
+++ b/theseus/desktop/d3d8_sdl.h
@@ -19,10 +19,14 @@ extern "C" void stbi_image_free(void*);
 #elif defined(_WIN32)
         #include <windows.h>
         #include <GL/gl.h>
-#else
+#elif __has_include(<GL/gl.h>)
     #define GL_GLEXT_PROTOTYPES
     #include <GL/gl.h>
     #include <GL/glext.h>
+#else
+    // EGL-only Mesa (KMSDRM): no desktop GL headers, and GLES2's carry the
+    // same base typedefs and the few enums used here.
+    #include <GLES2/gl2.h>
 #endif
 
 // Ensure D3D vertex constructors are available (vertex8.h, hud.cpp)
@@ -986,6 +990,10 @@ inline void CRT_ResizeFBO_Bgfx(int width, int height) {
 // recent setViewFrameBuffer call to *all* submits on that view in the
 // frame (so resetting after submits would draw the scene to the
 // backbuffer instead of into the FBO).
+// The fixed-size scene target on KMSDRM (THESEUS_SCENE), or invalid when
+// the scene draws straight to the backbuffer. See sdl_main.cpp.
+extern bgfx::FrameBufferHandle g_sceneFB;
+
 inline void CRT_BeginCapture_Bgfx() {
     bgfx::setViewFrameBuffer(0, g_crt.fb);
 }
@@ -994,14 +1002,14 @@ inline void CRT_BeginCapture_Bgfx() {
 // backbuffer once CRT goes off again (the previous frame may have left
 // it pointing at the offscreen FB).
 inline void CRT_PointViewToBackbuffer_Bgfx() {
-    bgfx::setViewFrameBuffer(0, BGFX_INVALID_HANDLE);
+    bgfx::setViewFrameBuffer(0, g_sceneFB);
 }
 
 // Submit the fullscreen blit into view 1 (which targets the backbuffer)
 // with the CRT shader sampling view 0's color attachment.
 inline void CRT_EndAndBlit_Bgfx(float time, int width, int height) {
     // View 1 = post-process pass to backbuffer.
-    bgfx::setViewFrameBuffer(1, BGFX_INVALID_HANDLE);
+    bgfx::setViewFrameBuffer(1, g_sceneFB);
     bgfx::setViewRect(1, 0, 0, (uint16_t)width, (uint16_t)height);
     bgfx::setViewClear(1, 0); // backbuffer is fully overwritten by the quad
 
diff --git a/theseus/desktop/display.h b/theseus/desktop/display.h
index a4748e4..aecb213 100644
--- a/theseus/desktop/display.h
+++ b/theseus/desktop/display.h
@@ -12,3 +12,7 @@ void Plat_GetWindowSize(int* w, int* h);
 
 // pixels / points. 2.0 on Retina.
 float Plat_GetDisplayScale(void);
+
+// bgfx::frame(), plus the buffer swap and page flip when SDL owns the GL
+// context (KMSDRM).
+void Plat_Present(void);
diff --git a/theseus/desktop/preloader.cpp b/theseus/desktop/preloader.cpp
