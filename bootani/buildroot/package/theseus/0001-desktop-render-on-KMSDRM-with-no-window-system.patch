From: Claude <noreply@anthropic.com>
Subject: [PATCH] desktop: render on KMSDRM with no window system

On Linux, bgfx is only handed an X11 or Wayland window. Under SDL's KMSDRM
driver there is no such window, so SDL creates the GL context itself (EGL
on a GBM surface) and bgfx renders into it with its OpenGL backend,
single threaded. Presenting becomes bgfx::frame() followed by
SDL_GL_SwapWindow(), which also does the KMS page flip.

Also adds --no-boot-anim, for when something else already played the
boot animation, and two build knobs: NO_MILKDROP=1 (no projectM, no
libGL) and NO_VULKAN=1 (bgfx built for OpenGL only, no Vulkan or X11).
Without desktop GL headers, d3d8_sdl.h takes its GL typedefs from GLES2.

On KMSDRM the log is the only view into the machine, so stdout is
line-buffered and key presses are logged with where focus is.

THESEUS_SCENE=WxH (KMSDRM only) renders the whole frame at a fixed size
and stretches it over the display mode, the way the Xbox drew the
dashboard at 640x480 and its video encoder stretched that across a
720x480 NTSC signal.

Upstream: not sent
Signed-off-by: Claude <noreply@anthropic.com>
---
diff --git a/build/Makefile b/build/Makefile
index 49656f2..584278b 100644
--- a/build/Makefile
+++ b/build/Makefile
@@ -459,7 +459,11 @@ else ifeq ($(UNAME_S),Linux)
   SDL2_CFLAGS  := $(shell sdl2-config --cflags)
   SDL2_LDFLAGS := $(shell sdl2-config --libs)
   # OpenGL is for projectM, not a dashboard render backend.
-  DESKTOP_PLATFORM_LDFLAGS = -lGL -lSDL2_mixer
+  ifdef NO_MILKDROP
+    DESKTOP_PLATFORM_LDFLAGS = -lSDL2_mixer
+  else
+    DESKTOP_PLATFORM_LDFLAGS = -lGL -lSDL2_mixer
+  endif
 else
   # Windows (MSYS2/MinGW). Native Windows desktop builds are unsupported;
   # use the desktop-win64 cross target for Windows.
@@ -518,6 +522,9 @@ MSYS2 `pacman -S mingw-w64-x86_64-curl`)
   # the .cpp compile rule fires. (A previous version gated on a
   # parse-time wildcard, which caused first-time `make desktop` runs on
   # a clean checkout to silently ship a no-milkdrop binary.)
+  # NO_MILKDROP=1 leaves the visualizer out (and the GL / projectM build
+  # with it), for targets without libGL such as a KMSDRM-only Mesa.
+  ifndef NO_MILKDROP
   PROJECTM_PREFIX := $(THESEUS_SRC)/third-party/projectm/install
   PROJECTM_CFLAGS  := -I$(PROJECTM_PREFIX)/include -DTHESEUS_HAS_MILKDROP=1
   ifeq ($(UNAME_S),Darwin)
@@ -527,6 +534,7 @@ MSYS2 `pacman -S mingw-w64-x86_64-curl`)
   endif
   PROJECTM_LDFLAGS := -L$(PROJECTM_PREFIX)/lib -lprojectM-4 -lprojectM-4-playlist \
                       $(PROJECTM_RPATH)
+  endif
 endif
 CDAUDIO_CFLAGS  := $(MPV_CFLAGS)
 CDAUDIO_LDFLAGS :=
@@ -644,12 +652,16 @@ else ifeq ($(UNAME_S),Linux)
   #   make -C theseus/third-party/bgfx linux-gcc-release64
   # bgfx on Linux uses Vulkan by default. Runtime needs vulkan-loader
   # + X11 system libs; -ldl/-lpthread are for bgfx's RTLD use.
-  BGFX_BUILD_DIR  := $(BGFX_ROOT)/.build/linux64_gcc/bin
+  BGFX_BUILD_DIR  ?= $(BGFX_ROOT)/.build/linux64_gcc/bin
   DESKTOP_CFLAGS  += -I$(BX_ROOT)/include/compat/linux
   DESKTOP_LDFLAGS += $(BGFX_BUILD_DIR)/libbgfxRelease.a \
                      $(BGFX_BUILD_DIR)/libbxRelease.a \
                      $(BGFX_BUILD_DIR)/libbimgRelease.a \
-                     -lvulkan -lX11 -ldl -lpthread
+                     -ldl -lpthread
+  # NO_VULKAN=1: bgfx built for OpenGL only (KMSDRM), so no Vulkan or X11.
+  ifndef NO_VULKAN
+    DESKTOP_LDFLAGS += -lvulkan -lX11
+  endif
 endif
 
 # Desktop sources: ALL from theseus/desktop/ (UIX Desktop tree imported in full).
@@ -925,7 +937,11 @@ PROJECTM_SRC    := $(abspath $(THESEUS_SRC)/third-party/projectm)
 PROJECTM_MARKER := $(PROJECTM_SRC)/install/include/projectM-4/projectM.h
 
 .PHONY: projectm-deps projectm-clean
+ifdef NO_MILKDROP
+projectm-deps:
+else
 projectm-deps: $(PROJECTM_MARKER)
+endif
 
 $(PROJECTM_MARKER):
 	@if [ ! -f $(PROJECTM_SRC)/CMakeLists.txt ]; then \
