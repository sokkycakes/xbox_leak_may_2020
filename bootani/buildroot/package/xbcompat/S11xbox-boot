#!/bin/sh
#
# The boot animation (ani2's Bootscreen.xbe under xbcompat) on images with no
# bootani, such as the Raspberry Pi's: run it in the background right after
# udev (which loads the GPU driver), under bootani's pid file, which
# xbox-session waits on.
#

PIDFILE=/var/run/bootani.pid

case "$1" in
	start)
		printf 'Starting the boot animation: '
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /bin/sh \
			-- -c "exec /usr/libexec/xbox-boot >>/var/log/xbox-boot.log 2>&1"
		echo OK
		;;
	stop)
		start-stop-daemon -K -q -p "$PIDFILE"
		rm -f "$PIDFILE"
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
