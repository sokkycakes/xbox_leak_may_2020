#!/bin/sh
#
# Start the Xbox boot animation before anything else, in the background, so
# the rest of the boot carries on while it plays.
#

DAEMON="bootani"
PIDFILE="/var/run/$DAEMON.pid"
LOGFILE="/var/log/$DAEMON.log"
BOOTANI_ARGS="--kms"

# shellcheck source=/dev/null
[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"
# shellcheck source=/dev/null
[ -r /etc/default/kms ] && . /etc/default/kms
export KMS_MODE

# bootani, the native animation, unless BOOT_ANIMATION=xbox asks for the
# Xbox's own under xbcompat (package/xbcompat, which falls back to bootani).
# On images with a split system (package/sion-tools), /data/overlay is in
# place this early, so /etc/default/bootani there counts.
#
# With the Xbox dashboard, bootani then keeps its last frame (the logo) on
# screen until the dashboard's session starts its display keeper (xbox-av),
# gives the frame to it, and xbox-av keeps it there until the dashboard's
# first frame: as on the Xbox, the logo stays up until the dashboard draws.
CMD="/usr/bin/$DAEMON $BOOTANI_ARGS"
if [ -x /usr/libexec/xbox-boot ] && [ "$BOOT_ANIMATION" = xbox ]; then
	CMD=/usr/libexec/xbox-boot
elif [ -x /opt/xbcompat/bin/xbox-av ] && [ -x /usr/libexec/dashboard ] &&
	[ "$(/usr/libexec/dashboard)" = xbox ]; then
	CMD="$CMD --handoff /var/run/xbox-av.sock"
fi

# The LinuxBoot boot menu played the animation already (sion.bootani=done),
# and left its last frame on screen for the dashboard to take over.
SKIP=
grep -q 'sion\.bootani=done' /proc/cmdline 2>/dev/null && SKIP=yes

start() {
	# The signal for the TV (sion-video: 15 kHz 480i for a VGA transcoder,
	# or 480p): an EDID on the connector and KMS_MODE, before anything
	# draws.
	if [ -x /usr/libexec/sion-video ]; then
		/usr/libexec/sion-video early >> /var/log/sion-video.log 2>&1
		# shellcheck source=/dev/null
		. /etc/default/kms
		export KMS_MODE
	fi
	# The Xbox's display keeper (xbox-av, see package/xbcompat) before
	# anything else: black in the session's mode, and the console never
	# drawn again. Only for the Xbox animation: bootani needs the display
	# to itself.
	if [ -n "$SKIP" ]; then
		echo "Starting $DAEMON: played by the boot menu"
		return 0
	fi
	if [ "$CMD" = /usr/libexec/xbox-boot ]; then
		# shellcheck source=/dev/null
		. /usr/lib/xbox/xbox-env
		xbox_av_start
	fi
	printf 'Starting %s: ' "$DAEMON"
	# Through a shell so its messages land in $LOGFILE; exec keeps the pid.
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /bin/sh \
		-- -c "exec $CMD >$LOGFILE 2>&1"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"
	# bootani hands the display back to the console on SIGTERM.
	start-stop-daemon -K -q -p "$PIDFILE"
	status=$?
	rm -f "$PIDFILE"
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

case "$1" in
	start|stop)
		"$1";;
	restart|reload)
		stop
		start;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
