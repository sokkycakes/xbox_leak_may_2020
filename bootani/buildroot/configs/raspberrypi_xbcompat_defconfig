# Raspberry Pi 3, 3B+, Zero 2 W and 4 (5 untested): the Xbox's boot animation
# and dashboard under xbcompat, straight on KMSDRM, with the Xbox code run
# by Box86 with the renderer native on ARM (Unicorn remains a fallback).
# A 32-bit (armhf) userspace, as
# xbcompat needs, under the Raspberry Pi Foundation's 64-bit kernel.
BR2_arm=y
BR2_cortex_a53=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y
BR2_TARGET_GENERIC_HOSTNAME="xbox-pi"
BR2_TARGET_GENERIC_ISSUE="xbcompat on Raspberry Pi"
BR2_TARGET_GENERIC_ROOT_PASSWD="xbox"
BR2_TARGET_GENERIC_GETTY_PORT="console"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BOOTANI_PATH)/patches"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BOOTANI_PATH)/board/raspberrypi/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BOOTANI_PATH)/board/raspberrypi/post-image.sh"
# The kernel, its modules and device trees are the Foundation's prebuilt
# ones (board/raspberrypi/post-*.sh), from the same firmware release.
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_BOOTANI_PATH)/board/raspberrypi/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_BOOTANI_PATH)/board/raspberrypi/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTBS=y
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BOOTANI_PATH)/board/raspberrypi/busybox.fragment"
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_XZ=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
# GPU: vc4 (Pi 3, Zero 2 W) and v3d (Pi 4, 5); softpipe draws when there is
# no GPU driver (QEMU). Desktop OpenGL through glvnd's libOpenGL and EGL.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_LIBGLVND=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_GESFTPSERVER=y
BR2_PACKAGE_UNICORN=y
BR2_PACKAGE_BOX86=y
BR2_PACKAGE_XBCOMPAT=y
BR2_PACKAGE_XBCOMPAT_TITLES="$(BR2_EXTERNAL_BOOTANI_PATH)/../../xbcompat/build-pi/xbcompat-titles.tar.gz"
