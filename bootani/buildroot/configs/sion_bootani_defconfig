# Acer Chromebox CXI3 ("sion"): Kaby Lake, Intel UHD 620 through Mesa iris.
# softpipe is a CPU fallback: it lets the same image show the animation (slowly)
# in QEMU or if iris fails.
BR2_x86_64=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y
BR2_TARGET_GENERIC_HOSTNAME="bootani"
BR2_TARGET_GENERIC_ISSUE="bootani"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BOOTANI_PATH)/board/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BOOTANI_PATH)/board/common/post-image.sh"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BOOTANI_PATH)/patches"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_BOOTANI=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BOOTANI_PATH)/board/common/linux.fragment $(BR2_EXTERNAL_BOOTANI_PATH)/board/sion/linux.fragment"
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
# The Theseus dashboard, after the boot animation (SDL2 on KMSDRM + bgfx GL).
# SDL2's KMSDRM driver needs GLES enabled at build time; Theseus itself asks
# for a desktop OpenGL 3.3 core context.
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_MPV=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_THESEUS=y
# Remote access (SSH over Wi-Fi, wired or USB Ethernet), a persistent /data
# partition and A/B image updates (package/sion-tools, sion/sion.conf on the
# stick). Wi-Fi firmware for the Intel cards Kaby Lake Chromeboxes ship with.
BR2_PACKAGE_SION_TOOLS=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8000C=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
BR2_PACKAGE_HOST_E2FSPROGS=y
# The Xbox's own boot animation and dashboard under xbcompat; the bundle is
# built by xbcompat/tools/sion/bundle.sh.
BR2_PACKAGE_XBCOMPAT=y
BR2_PACKAGE_XBCOMPAT_BUNDLE="$(BR2_EXTERNAL_BOOTANI_PATH)/../../xbcompat/build-sion/xbcompat-sion.tar.gz"
