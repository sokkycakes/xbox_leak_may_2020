#!/bin/sh
#
# Shows the main screen on MCT Trigger 6 USB display adapters (j5create
# JUA365): t6-mirror runs whenever an adapter is plugged in and comes back
# after it's unplugged and plugged in again. It never changes the main
# display. Options: /etc/default/t6-mirror (T6_MIRROR_ARGS="-r 60" etc.);
# touch /etc/sion/t6-mirror.off to keep it off.
PID=/var/run/t6-mirror.pid
LOG=/var/log/t6-mirror.log

start() {
	[ -e /etc/sion/t6-mirror.off ] && return 0
	[ -e $PID ] && kill -0 "$(cat $PID)" 2>/dev/null && return 0
	T6_MIRROR_ARGS="-r 30"
	[ -r /etc/default/t6-mirror ] && . /etc/default/t6-mirror
	(
		# Let the dashboard take the main screen first.
		n=0
		while ! pidof xbcompat > /dev/null && [ $n -lt 30 ]; do sleep 2; n=$((n + 1)); done
		while :; do
			found=
			for c in /sys/class/drm/card[0-9]; do
				[ "$(basename "$(readlink -f "$c/device/driver" 2>/dev/null)")" = trigger6 ] && found=1
			done
			if [ -n "$found" ]; then
				[ -f $LOG ] && [ "$(wc -c < $LOG)" -gt 200000 ] && mv $LOG $LOG.old
				/usr/bin/t6-mirror $T6_MIRROR_ARGS >> $LOG 2>&1
			fi
			sleep 3
		done
	) < /dev/null > /dev/null 2>&1 &
	echo $! > $PID
}

stop() {
	[ -e $PID ] && kill "$(cat $PID)" 2>/dev/null
	rm -f $PID
	killall t6-mirror 2>/dev/null
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "usage: $0 start|stop|restart"; exit 1 ;;
esac
