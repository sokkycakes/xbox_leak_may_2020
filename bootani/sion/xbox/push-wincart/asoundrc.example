# What wincart-run writes to /root/.asoundrc inside the Conty chroot (hw:PCH,3
# is the output xbox-env picks, AUDIODEV=hdmi:CARD=PCH,DEV=0). Wine plays
# through the softvol control "Wincart" (the Guide's volume slider and its
# ducking set it with amixer); the Guide's own sounds go to wincart_out
# directly, mixed over the game by dmix.
pcm.wincart_out { type dmix ipc_key 50503 ipc_perm 0666 slave { pcm "hw:PCH,3" rate 48000 } }
pcm.wincart_vol { type softvol slave.pcm "wincart_out" control { name "Wincart" card 0 } }
pcm.!default { type plug slave.pcm "wincart_vol" }
ctl.!default { type hw card 0 }
