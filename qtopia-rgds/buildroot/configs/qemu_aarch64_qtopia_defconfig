# QEMU aarch64 virt test image for Qt Extended (stands in for the RG DS)
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_TARGET_GENERIC_HOSTNAME="rgds"
BR2_TARGET_GENERIC_ISSUE="Qt Extended on RG DS (QEMU test)"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_QTOPIA_RGDS_PATH)/board/qemu-rgds/rootfs-overlay"
BR2_SYSTEM_DHCP="eth0"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_QTOPIA_RGDS_PATH)/board/qemu-rgds/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
# Qt Extended runtime deps
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_TSLIB=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_SPEEXDSP=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_LIBXCRYPT=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_QTOPIA_RGDS_PATH)/board/qemu-rgds/post-build.sh"
BR2_PACKAGE_STRACE=y
BR2_TARGET_TZ_INFO=y
BR2_TARGET_TZ_ZONELIST="default"
BR2_TARGET_LOCALTIME="Etc/UTC"
