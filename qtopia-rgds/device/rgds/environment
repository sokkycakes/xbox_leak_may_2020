#!/bin/sh
# Cross build for the RG DS. The mkspec reaches the Buildroot toolchain and
# staging dir through fixed links (see qtopia-rgds/setup-sdk.sh):
#   /opt/rgds-sdk/host    -> <buildroot output>/host
#   /opt/rgds-sdk/sysroot -> <buildroot output>/staging
QTMOKO_SYSROOT=/opt/rgds-sdk/sysroot
echo "Running environment script for device rgds with sysroot $QTMOKO_SYSROOT"

PKG_CONFIG_PATH=$QTMOKO_SYSROOT/usr/lib/pkgconfig:$QTMOKO_SYSROOT/usr/share/pkgconfig
PKG_CONFIG_SYSROOT_DIR=$QTMOKO_SYSROOT
export PKG_CONFIG_PATH PKG_CONFIG_SYSROOT_DIR
