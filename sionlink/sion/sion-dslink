#!/bin/sh
# sion-dslink: DS local wireless for the Sion (Sion Link).
#
#   sion-dslink check        what the Wi-Fi card supports, nothing changes
#   sion-dslink start [CH]   add a second, DS-only network next to the home
#                            Wi-Fi and start sionlinkd
#   sion-dslink stop
#   sion-dslink status
#   sion-dslink say TEXT     show TEXT on every linked DS
#   sion-dslink txtrace [N]  send N messages and show the rate each frame
#                            goes out at (needs kprobe tracing)
#
# The home Wi-Fi link (and SSH over it) is never touched: start refuses when
# the card can't run an access point beside it, unless --force is given.

DIR=/opt/sionlink
RUN=/run/sionlink
# The home Wi-Fi interface: the first wireless one that isn't ours
PHY_IF=$SIONLINK_WIFI
if [ -z "$PHY_IF" ]; then
    for p in /sys/class/net/*; do
        i=${p##*/}
        [ "$i" = sionds ] && continue
        [ -e "$p/phy80211" ] && { PHY_IF=$i; break; }
    done
fi
AP_IF=sionds

log() { echo "sion-dslink: $*"; }

phy_of() {
    iw dev "$1" info 2>/dev/null | sed -n 's/^.*wiphy \([0-9]*\).*/phy\1/p'
}

home_freq() {
    iw dev "$PHY_IF" link 2>/dev/null | sed -n 's/^.*freq: \([0-9]*\).*/\1/p'
}

freq_to_ch() {
    f=$1
    if [ "$f" -ge 2412 ] && [ "$f" -le 2472 ]; then echo $(( (f - 2407) / 5 ))
    elif [ "$f" -eq 2484 ]; then echo 14
    else echo 0; fi
}

# Prints the max number of distinct channels in a combination that allows
# both a managed (station) and an AP interface, or 0 if none does.
ap_combo_channels() {
    iw phy "$1" info 2>/dev/null | awk '
        /valid interface combinations/ { inc = 1; next }
        inc && /^\t[A-Z]/ { inc = 0 }
        inc && /\* #\{/ { line = $0; m = (line ~ /managed/); a = (line ~ /AP/) }
        inc && /#channels <=/ {
            if (m && a) { sub(/.*#channels <= /, ""); sub(/[^0-9].*/, ""); if ($0 + 0 > best) best = $0 + 0 }
        }
        END { print best + 0 }'
}

do_check() {
    phy=$(phy_of "$PHY_IF")
    [ -n "$phy" ] || { log "no Wi-Fi interface $PHY_IF"; return 1; }
    log "card: $phy ($(cat /sys/class/net/$PHY_IF/device/uevent 2>/dev/null | sed -n 's/^DRIVER=//p'))"
    f=$(home_freq)
    if [ -n "$f" ]; then
        log "home Wi-Fi on $f MHz (channel $(freq_to_ch "$f"); 0 means 5 GHz)"
    else
        log "home Wi-Fi not connected"
    fi
    iw phy "$phy" info | sed -n '/Supported interface modes/,/Band 1/p' | grep -E "^[[:space:]]+\* (AP|managed|monitor)$" | sed 's/^/    mode:/'
    iw phy "$phy" info | sed -n '/valid interface combinations/,/^\t[A-Z]/p' | sed 's/^/    /'
    ch=$(ap_combo_channels "$phy")
    if [ "$ch" -gt 0 ]; then
        log "OK: an access point can run beside the home Wi-Fi ($ch channel(s) at once)"
    else
        log "NO: this card can't run an access point beside the home Wi-Fi"
    fi
    [ -x "$DIR/bin/hostapd" ] && [ -x "$DIR/bin/sionlinkd" ] && log "programs installed in $DIR" || log "programs missing from $DIR"
}

do_start() {
    force=0
    want_ch=
    for a in "$@"; do
        case "$a" in --force) force=1 ;; *) want_ch=$a ;; esac
    done
    [ -f "$RUN/hostapd.pid" ] && kill -0 "$(cat "$RUN/hostapd.pid")" 2>/dev/null && { log "already running"; return 0; }
    # sion-netd would otherwise treat the DS network as a second home Wi-Fi
    # and move the Sion's address and default route onto it.
    if ! grep -q 'ifc" = sionds' /usr/libexec/sion-netd; then
        log "sion-netd doesn't know about the DS network yet; run install-sionlink.sh first"
        return 1
    fi

    phy=$(phy_of "$PHY_IF")
    [ -n "$phy" ] || { log "no Wi-Fi interface $PHY_IF"; return 1; }
    maxch=$(ap_combo_channels "$phy")
    f=$(home_freq)
    home_ch=0
    [ -n "$f" ] && home_ch=$(freq_to_ch "$f")

    if [ "$maxch" -eq 0 ] && [ -n "$f" ] && [ $force -eq 0 ]; then
        log "the card can't host beside the home Wi-Fi; not starting (SSH would drop). Use --force to try anyway."
        return 1
    fi

    # The DS only does 2.4 GHz. With one channel at a time we must share the
    # home network's channel, which then has to be 2.4 GHz.
    if [ -n "$want_ch" ]; then ch=$want_ch
    elif [ "$home_ch" -gt 0 ]; then ch=$home_ch
    else ch=6; fi
    if [ -n "$f" ] && [ "$maxch" -lt 2 ] && [ "$ch" != "$home_ch" ] && [ $force -eq 0 ]; then
        log "home Wi-Fi is on ${f} MHz and the card can only use one channel at a time; the DS needs 2.4 GHz. Not starting."
        return 1
    fi

    mkdir -p "$RUN"
    # Always start from a fresh interface: one left behind by a hostapd that
    # died can still be beaconing, and a new hostapd then fails to start.
    iw dev "$AP_IF" del 2>/dev/null
    iw phy "$phy" interface add "$AP_IF" type __ap || { log "couldn't add $AP_IF"; return 1; }
    # A different, locally administered MAC from the home interface
    mac=$(cat /sys/class/net/$PHY_IF/address)
    ip link set "$AP_IF" address "02:${mac#*:}" 2>/dev/null

    ve=$("$DIR/bin/sionlinkd" --vendor-element)
    sed -e "s/@IF@/$AP_IF/" -e "s/@CH@/$ch/" -e "s/@VE@/$ve/" \
        "$DIR/hostapd-sionlink.conf.in" > "$RUN/hostapd.conf"
    # hostapd prints its startup errors before going to the background
    rm -f "$RUN/hostapd.pid"
    "$DIR/bin/hostapd" -B -P "$RUN/hostapd.pid" "$RUN/hostapd.conf" > "$RUN/hostapd.log" 2>&1 || {
        log "hostapd failed:"; tail -8 "$RUN/hostapd.log"; iw dev "$AP_IF" del; return 1; }

    rm -f "$RUN/in"; mkfifo "$RUN/in"
    (
        exec 3<>"$RUN/in"
        exec "$DIR/bin/sionlinkd" --if "$AP_IF" --name "${SIONLINK_NAME:-$(hostname)}" -v <&3 >>"$RUN/sionlinkd.log" 2>&1
    ) &
    echo $! > "$RUN/sionlinkd.pid"
    sleep 1
    log "DS network up on channel $ch ($AP_IF); logs in $RUN"
}

do_stop() {
    for p in sionlinkd hostapd; do
        [ -f "$RUN/$p.pid" ] && kill "$(cat "$RUN/$p.pid")" 2>/dev/null
        rm -f "$RUN/$p.pid"
    done
    # Also any copy that lost its pid file (a debug run, or a crash): a stray
    # hostapd takes the DS interface back the moment it's recreated.
    # Matched by name: after a reinstall the old binary shows as "(deleted)".
    for d in /proc/[0-9]*; do
        case "$(cat "$d/comm" 2>/dev/null)" in
            hostapd|sionlinkd) kill "${d#/proc/}" 2>/dev/null ;;
        esac
    done
    sleep 1
    iw dev "$AP_IF" del 2>/dev/null
    log "stopped"
}

do_status() {
    if [ -f "$RUN/hostapd.pid" ] && kill -0 "$(cat "$RUN/hostapd.pid")" 2>/dev/null; then
        log "running"
        iw dev "$AP_IF" info 2>/dev/null | grep -E "channel|addr" | sed 's/^/    /'
        iw dev "$AP_IF" station dump 2>/dev/null | grep -E "^Station|tx bitrate|rx bitrate" | sed 's/^/    /'
        tail -5 "$RUN/sionlinkd.log" 2>/dev/null
    else
        log "not running"
    fi
}

# Sends N messages to the DS and shows, for every frame the Intel driver hands
# to the card, the rate, antenna and station the card was told to use.
# Uses a kprobe on iwl_trans_tx (TX command layout v6: tx_flags at +8,
# rate_n_flags at +16, sta_id at +20, 802.11 header at +60 of dev_cmd).
do_txtrace() {
    n=${1:-50}
    T=/sys/kernel/tracing
    [ -e "$T/kprobe_events" ] || mount -t tracefs nodev "$T" 2>/dev/null
    if [ ! -e "$T/kprobe_events" ]; then
        mount -t debugfs nodev /sys/kernel/debug 2>/dev/null
        T=/sys/kernel/debug/tracing
    fi
    [ -e "$T/kprobe_events" ] || { log "this kernel has no kprobe tracing"; return 1; }
    [ -p "$RUN/in" ] || { log "not running"; return 1; }
    echo 0 > "$T/tracing_on"
    [ -e "$T/events/kprobes/sltx" ] && { echo 0 > "$T/events/kprobes/sltx/enable"; echo '-:sltx' >> "$T/kprobe_events"; }
    echo 'p:sltx iwl_trans_tx q=$arg4:s32 flags=+8($arg3):x32 rate=+16($arg3):x32 sta=+20($arg3):u8 fc=+60($arg3):x16 a1=+64($arg3):x16 a1b=+66($arg3):x32' >> "$T/kprobe_events" ||
        { log "could not add the kprobe"; return 1; }
    echo > "$T/trace"
    echo 1 > "$T/events/kprobes/sltx/enable"
    echo 1 > "$T/tracing_on"
    i=0
    while [ $i -lt "$n" ]; do echo "trace $i" > "$RUN/in"; i=$((i + 1)); done
    sleep 3
    echo 0 > "$T/events/kprobes/sltx/enable"
    log "frames sent to the card while sending $n messages:"
    awk '
        function hex(s,   i, c, v) { v = 0; s = tolower(s); sub(/^0x/, "", s)
            for (i = 1; i <= length(s); i++) { c = index("0123456789abcdef", substr(s, i, 1)) - 1; v = v * 16 + c }
            return v }
        / sltx: / {
            for (f = 1; f <= NF; f++) { split($f, kv, "="); if (kv[2] != "") v[kv[1]] = kv[2] }
            r = hex(v["rate"]); fl = hex(v["flags"]); fc = hex(v["fc"])
            a = hex(v["a1"]) % 256
            plcp = r % 256
            mod = (int(r / 512) % 2) ? "CCK" : "OFDM"
            ant = int(r / 16384) % 4
            if (fl % 32 >= 16) desc = "station rate table"
            else desc = sprintf("%s plcp %d ant %s", mod, plcp, (ant == 1 ? "A" : ant == 2 ? "B" : ant == 3 ? "AB" : "none"))
            type = int(fc / 4) % 4; sub_t = int(fc / 16) % 16
            kind = (type == 0 ? "mgmt" : type == 2 ? "data" : "other") sub_t
            key = sprintf("q %s sta %s %s to %s: %s", v["q"], v["sta"], kind, (a == 255 ? "bcast" : "unicast"), desc)
            cnt[key]++
        }
        END { for (k in cnt) printf "  %4d x %s\n", cnt[k], k }' "$T/trace"
    log "(CCK plcp 10 = 1 Mbit/s, 20 = 2 Mbit/s; anything OFDM the DS cannot hear)"
}

case "$1" in
    check) do_check ;;
    start) shift; do_start "$@" ;;
    stop) do_stop ;;
    restart) do_stop; shift; do_start "$@" ;;
    status) do_status ;;
    txtrace) shift; do_txtrace "$@" ;;
    say) shift; [ -p "$RUN/in" ] && echo "$*" > "$RUN/in" || log "not running" ;;
    *) echo "usage: sion-dslink check|start [CH] [--force]|stop|status|say TEXT|txtrace [N]"; exit 2 ;;
esac
