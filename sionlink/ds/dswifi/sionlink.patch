diff --git a/source/arm7/ntr/update.c b/source/arm7/ntr/update.c
index ddac61f..d4cf3d4 100644
--- a/source/arm7/ntr/update.c
+++ b/source/arm7/ntr/update.c
@@ -393,6 +393,38 @@ void Wifi_NTR_Update(void)
                 break;
             }
 
+            // Sion Link: some access points (Intel cards in AP mode) reach the
+            // DS with broadcasts only, so their auth and assoc replies never
+            // arrive. In multiplayer client mode, don't wait for them: after a
+            // short pause, go on as if they had arrived. The host accepts the
+            // DS without hearing it acknowledge those replies.
+            if ((WifiData->curLibraryMode == DSWIFI_MULTIPLAYER_CLIENT) &&
+                ((W_US_COUNT1 - WifiData->counter7) > 3)) // about 200 ms
+            {
+                WifiData->counter7 = W_US_COUNT1;
+
+                if (WifiData->authlevel == WIFI_AUTHLEVEL_DISCONNECTED)
+                {
+                    WLOG_PUTS("W: No auth reply, going on\n");
+                    WifiData->authlevel = WIFI_AUTHLEVEL_AUTHENTICATED;
+                    WifiData->realRates = true;
+                    Wifi_SendAssocPacket();
+                }
+                else if (WifiData->authlevel == WIFI_AUTHLEVEL_AUTHENTICATED)
+                {
+                    WLOG_PUTS("W: No assoc reply, going on\n");
+                    // We never learn the AID the host gave us. With AID 0 the
+                    // hardware keeps ignoring data from the host, so use 1:
+                    // the AID only picks a reply slot in CMD/REPLY exchanges,
+                    // which the Sion doesn't use.
+                    Wifi_NTR_SetAssociationID(1);
+                    Wifi_NTR_SetupTransferOptions(WIFI_TRANSFER_RATE_2MBPS, false);
+                    WifiData->authlevel = WIFI_AUTHLEVEL_ASSOCIATED;
+                    WifiData->authctr   = 0;
+                }
+                break;
+            }
+
             // If the process stops (for example, because we don't receive a
             // packet) retry manually every now and then.
             if ((W_US_COUNT1 - WifiData->counter7) > 20) // 20 units is 1 sec aprox
@@ -538,6 +570,34 @@ void Wifi_NTR_Update(void)
         }
     }
 
+    // Sion Link: in promiscuous mode, also open the hardware RX filters so
+    // that every frame on the channel is received, whatever its BSSID or
+    // direction. Restore the filters of the current mode when it ends.
+    static bool rx_all = false;
+    if (WifiData->reqFlags & WFLAG_REQ_PROMISC)
+    {
+        // Not RXFILTER_UPDATE_WRCSR: it moves the RX write pointer before a
+        // frame is complete, and the RX queue then reads half-written frames.
+        W_RXFILTER  = RXFILTER_ALL & ~RXFILTER_UPDATE_WRCSR;
+        W_RXFILTER2 = 0;
+        rx_all = true;
+    }
+    else if (rx_all)
+    {
+        rx_all = false;
+        if (WifiData->curMode == WIFIMODE_SCAN)
+            Wifi_SetupFilterMode(WIFI_FILTERMODE_SCAN);
+        else if (WifiData->curMode == WIFIMODE_ACCESSPOINT)
+            Wifi_SetupFilterMode(WIFI_FILTERMODE_MULTIPLAYER_HOST);
+        else if ((WifiData->curMode == WIFIMODE_CONNECTING) ||
+                 (WifiData->curMode == WIFIMODE_CONNECTED))
+            Wifi_SetupFilterMode(
+                (WifiData->curLibraryMode == DSWIFI_MULTIPLAYER_CLIENT) ?
+                WIFI_FILTERMODE_MULTIPLAYER_CLIENT : WIFI_FILTERMODE_INTERNET);
+        else
+            Wifi_SetupFilterMode(WIFI_FILTERMODE_IDLE);
+    }
+
     // First, check if we have received anything and handle it
     Wifi_RxQueueFlush();
 
