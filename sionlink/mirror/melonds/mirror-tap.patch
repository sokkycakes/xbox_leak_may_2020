diff --git a/src/MirrorTap.h b/src/MirrorTap.h
new file mode 100644
index 0000000..173214b
--- /dev/null
+++ b/src/MirrorTap.h
@@ -0,0 +1,39 @@
+// Sion Link screen mirroring: lets an outside recorder see every ARM9 I/O
+// write and each scanline start. Null when nothing is recording.
+#ifndef MIRRORTAP_H
+#define MIRRORTAP_H
+
+#include "types.h"
+
+namespace melonDS
+{
+class NDS;
+
+class MirrorTap
+{
+public:
+    virtual ~MirrorTap() {}
+    virtual void IOWrite(u32 addr, u32 val, int size) = 0;
+    virtual void Scanline(u32 vcount) = 0;
+};
+
+extern MirrorTap* gMirrorTap;
+
+// Lets an outside model answer some game card commands, for cart features
+// melonDS doesn't emulate (the DSpico's USB port). Null when unused.
+class CardHook
+{
+public:
+    virtual ~CardHook() {}
+    // a ROM transfer starts: cmd is the 8 command bytes, len the data length;
+    // return true to take the whole transfer
+    virtual bool Start(const u8* cmd, u32 len) = 0;
+    virtual u32 Receive() = 0;          // card -> DS word
+    virtual void Transmit(u32 val) = 0; // DS -> card word
+    virtual void Finish() = 0;
+};
+
+extern CardHook* gCardHook;
+}
+
+#endif
