#!/bin/sh
# Sion Link's DS pad (dspad): a DS running Sion Link on its DSpico is an Xbox 360 pad for
# the dashboard, Frolick and games while no DS game is mirrored; a DS title's mirror takes
# the DS over and gives it back when it ends. Log: /var/log/sionlink-pad.log.
# A second dspad takes a handheld's Sion Link app (the RG DS) over the network, on TCP 7791,
# as a pad of its own: the DS and the handheld can both play. Log: /var/log/sionlink-pad-net.log.
BIN=/opt/sionlink/dspad
PID=/var/run/sionlink-pad.pid
NETPID=/var/run/sionlink-pad-net.pid
NETPORT=${SIONLINK_PAD_PORT:-7791}
case "$1" in
start)
	[ -x "$BIN" ] || exit 0
	if ! { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }; then
		"$BIN" >>/var/log/sionlink-pad.log 2>&1 &
		echo $! >"$PID"
	fi
	if ! { [ -f "$NETPID" ] && kill -0 "$(cat "$NETPID")" 2>/dev/null; }; then
		"$BIN" --link tcp:$NETPORT --sock /run/sionlink-pad-net.sock >>/var/log/sionlink-pad-net.log 2>&1 &
		echo $! >"$NETPID"
	fi
	;;
stop)
	for p in "$PID" "$NETPID"; do
		[ -f "$p" ] && kill "$(cat "$p")" 2>/dev/null
		rm -f "$p"
	done
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
esac
