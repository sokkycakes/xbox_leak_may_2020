From 2f4c8a23b902c33ee9aa9a3e81f542ab6daf7f7b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 09:03:58 +0000
Subject: [PATCH] drivers/payload_select: Pick the payload from a CMOS byte

Boot an alternate payload (img/linuxboot by default) unless a CMOS byte
asks for the normal one (fallback/payload) once. coreboot marks the byte
before starting the alternate payload, and the payload clears the mark
once it is up, so a payload that hangs is skipped on the next boot.

Used by the Sion (google/fizz) boot menu: LinuxBoot shows a 15 kHz menu
and reboots into edk2 when edk2 is picked.
---
 src/drivers/payload_select/Kconfig          | 36 ++++++++++++++
 src/drivers/payload_select/Makefile.mk      |  3 ++
 src/drivers/payload_select/payload_select.c | 55 +++++++++++++++++++++
 3 files changed, 94 insertions(+)
 create mode 100644 src/drivers/payload_select/Kconfig
 create mode 100644 src/drivers/payload_select/Makefile.mk
 create mode 100644 src/drivers/payload_select/payload_select.c

diff --git a/src/drivers/payload_select/Kconfig b/src/drivers/payload_select/Kconfig
new file mode 100644
index 00000000..26a62d4b
--- /dev/null
+++ b/src/drivers/payload_select/Kconfig
@@ -0,0 +1,36 @@
+## SPDX-License-Identifier: GPL-2.0-only
+
+config PAYLOAD_CMOS_SELECT
+	bool "Choose between two payloads with a CMOS byte"
+	depends on DRIVERS_MC146818
+	default n
+	help
+	  Boot PAYLOAD_CMOS_SELECT_ALT (for example img/linuxboot) instead of
+	  the normal payload, unless a CMOS byte asks for the normal one.
+
+	  The byte at PAYLOAD_CMOS_SELECT_OFFSET is a one-shot request:
+	   0xC5  boot the normal payload once (written by the alternate
+	         payload's menu before it reboots), then clear the byte.
+	   0xB7  set by coreboot each time it starts the alternate payload.
+	         The alternate payload clears it once it is up. If it is
+	         still set on the next boot, the alternate payload hung or
+	         crashed last time, so the normal payload boots once instead.
+	  Anything else boots the alternate payload when it is in CBFS.
+	  If it is missing, the normal payload boots as usual.
+
+if PAYLOAD_CMOS_SELECT
+
+config PAYLOAD_CMOS_SELECT_ALT
+	string "CBFS name of the alternate (default) payload"
+	default "img/linuxboot"
+
+config PAYLOAD_CMOS_SELECT_OFFSET
+	hex "CMOS offset of the selection byte"
+	range 0x0e 0x7f
+	default 0x6c
+	help
+	  A byte in the first CMOS bank that nothing else uses. Avoid the
+	  RTC registers (0x00-0x0d), the century byte (0x32) and any
+	  option table or vboot nvdata range on the board.
+
+endif
diff --git a/src/drivers/payload_select/Makefile.mk b/src/drivers/payload_select/Makefile.mk
new file mode 100644
index 00000000..37f42d82
--- /dev/null
+++ b/src/drivers/payload_select/Makefile.mk
@@ -0,0 +1,3 @@
+## SPDX-License-Identifier: GPL-2.0-only
+
+ramstage-$(CONFIG_PAYLOAD_CMOS_SELECT) += payload_select.c
diff --git a/src/drivers/payload_select/payload_select.c b/src/drivers/payload_select/payload_select.c
new file mode 100644
index 00000000..b5f86952
--- /dev/null
+++ b/src/drivers/payload_select/payload_select.c
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * Pick the payload from a CMOS byte: the alternate payload (img/linuxboot)
+ * by default, the normal one (fallback/payload, e.g. edk2) when the byte
+ * asks for it once, or when the alternate payload didn't come up last time.
+ * See Kconfig for the byte's values.
+ */
+
+#include <cbfs.h>
+#include <console/console.h>
+#include <pc80/mc146818rtc.h>
+#include <program_loading.h>
+
+#define SEL_NORMAL_ONCE	0xc5
+#define SEL_ALT_PENDING	0xb7
+
+static const char *pick_payload(const char *normal)
+{
+	const u8 off = CONFIG_PAYLOAD_CMOS_SELECT_OFFSET;
+	const char *alt = CONFIG_PAYLOAD_CMOS_SELECT_ALT;
+	u8 v = cmos_read(off);
+
+	if (v == SEL_NORMAL_ONCE) {
+		cmos_write(0, off);
+		printk(BIOS_INFO, "payload_select: %s requested once\n", normal);
+		return normal;
+	}
+	if (v == SEL_ALT_PENDING) {
+		cmos_write(0, off);
+		printk(BIOS_WARNING, "payload_select: %s did not come up last boot, "
+		       "booting %s once\n", alt, normal);
+		return normal;
+	}
+	if (!cbfs_file_exists(alt)) {
+		printk(BIOS_INFO, "payload_select: no %s, booting %s\n", alt, normal);
+		return normal;
+	}
+	cmos_write(SEL_ALT_PENDING, off);
+	printk(BIOS_INFO, "payload_select: booting %s\n", alt);
+	return alt;
+}
+
+int prog_locate_hook(struct prog *prog)
+{
+	/* The hook can run more than once for the payload; decide once. */
+	static const char *chosen;
+
+	if (prog_type(prog) != PROG_PAYLOAD)
+		return 0;
+	if (!chosen)
+		chosen = pick_payload(prog_name(prog));
+	prog->name = chosen;
+	return 0;
+}
-- 
