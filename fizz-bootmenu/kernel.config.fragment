# LinuxBoot kernel for the Sion boot menu (Google Fizz, Kaby Lake-U Chromebox).
# Started from ../linuxboot-fizz/kernel.config.fragment, trimmed to what the
# menu needs: find a FAT boot partition on SATA/NVMe/USB/SD, show the menu on
# the TV at 15 kHz, read a keyboard or gamepad, kexec. No network.
# Applied on top of allnoconfig via scripts/kconfig/merge_config.sh.
# Everything is built in: there are no modules in a flash-resident kernel.

# --- Core ---
CONFIG_64BIT=y
CONFIG_LOCALVERSION="-crimsonboot"
CONFIG_DEFAULT_HOSTNAME="linuxboot"
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_FHANDLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_PRESERVE_MTIME=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y

# --- CPU / platform ---
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_MICROCODE=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_HPET_TIMER=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_MCORE2=n
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_PM=y
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_SIG=n
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_WATCHDOG=y
CONFIG_ITCO_WDT=y

# --- coreboot / ChromeOS firmware interfaces ---
CONFIG_GOOGLE_FIRMWARE=y
CONFIG_GOOGLE_COREBOOT_TABLE=y
CONFIG_GOOGLE_FRAMEBUFFER_COREBOOT=y
CONFIG_GOOGLE_MEMCONSOLE_COREBOOT=y
CONFIG_GOOGLE_CBMEM=y
CONFIG_GOOGLE_VPD=y
CONFIG_CHROME_PLATFORMS=y
CONFIG_CROS_EC=y
CONFIG_CROS_EC_LPC=y
CONFIG_CROS_EC_CHARDEV=y
CONFIG_MFD_CROS_EC_DEV=y
CONFIG_HW_RANDOM=y

# --- PCI / buses ---
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_I801=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_PINCTRL_SUNRISEPOINT=y

# --- Serial / console ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_LPSS=y

# --- Storage ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MISC_RTSX_PCI=y
CONFIG_MISC_RTSX_USB=y
CONFIG_MMC_REALTEK_PCI=y
CONFIG_MMC_REALTEK_USB=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# --- USB ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_TYPEC=y

# --- Input ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MICROSOFT=y

# --- Graphics ---
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Filesystems ---
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EFIVAR_FS=n
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_FAT_DEFAULT_UTF8=y


# --- Boot menu ---
# /dev/port: the menu reads and writes coreboot's payload byte in CMOS.
CONFIG_DEVMEM=y
CONFIG_DEVPORT=y
# The 15 kHz TV mode: the same EDID Crimson uses (VIC 10, 2880x480i, limited
# range), built into the kernel so i915's first frame is already 480i.
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="edid/crimson-480i.edid"
CONFIG_EXTRA_FIRMWARE_DIR="@FIRMWARE_DIR@"
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
# Gamepads: Xbox 360/One pads (xpad), plain HID ones through hid-generic.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
# QEMU's std VGA, so the exact same kernel can be tried in a VM (tiny).
CONFIG_DRM_BOCHS=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y

# Boot animation (bootani, played by crimsonboot while Crimson loads):
# HDMI audio through Intel HD Audio, and fbcon only once something prints,
# so the animation's last frame stays in fb0 untouched through the kexec.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y
CONFIG_SND_HDA_I915=y
CONFIG_SND_HDA_PREALLOC_SIZE=2048
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
