# MrChromebox fizz board config (configs/kbl/config.fizz.uefi) unchanged,
# plus the payload_select driver: edk2 stays the build's own payload
# (fallback/payload) and build.sh adds LinuxBoot as img/linuxboot. coreboot
# boots img/linuxboot unless the CMOS byte asks for edk2 once.
# Covers all fizz variants: SION (Acer CXI3), TEEMO (ASUS CN65),
# WUKONG (CTL CBx1), KENCH (HP G2), JAX (AOpen Commercial 2).
CONFIG_VENDOR_GOOGLE=y
CONFIG_INCLUDE_NHLT_BLOBS=y
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/fizz/flashdescriptor.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/fizz/me.bin"
CONFIG_BOARD_GOOGLE_FIZZ=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_EC_GOOGLE_CHROMEEC_FIRMWARE_EXTERNAL=y
CONFIG_EC_GOOGLE_CHROMEEC_FIRMWARE_FILE="3rdparty/blobs/mainboard/google/fizz/ec.RW.bin"
CONFIG_HAVE_ME_BIN=y
CONFIG_DO_NOT_TOUCH_DESCRIPTOR_REGION=y

# No firmware graphics: edk2 brings the screen up with its Intel GOP driver
# (as in the stock MrChromebox build), and on the LinuxBoot path i915 lights
# it for the first time, already at 15 kHz 480i. No 31 kHz frame reaches the
# transcoder before the menu.
CONFIG_NO_GFX_INIT=y
CONFIG_EDK2_ENABLE_IPXE=y

# The payload choice (coreboot-patches/0001).
CONFIG_PAYLOAD_CMOS_SELECT=y
CONFIG_PAYLOAD_CMOS_SELECT_ALT="img/linuxboot"
CONFIG_PAYLOAD_CMOS_SELECT_OFFSET=0x6c
