+++ b/common/vid_win.c
@@ -427,6 +427,8 @@ VID_InitModeList(void)
     memset(&devmode, 0, sizeof(devmode));
     devmode.dmSize = sizeof(devmode);
     success = EnumDisplaySettings(NULL, ENUM_REGISTRY_SETTINGS, &devmode);
+    if (!success) /* Windows PE keeps no saved display mode */
+        success = EnumDisplaySettings(NULL, ENUM_CURRENT_SETTINGS, &devmode);
     if (!success)
 	Sys_Error("Unable to query desktop display settings");
 
@@ -516,8 +518,17 @@ VID_SetDisplayMode(const qvidmode_t *mode)
     gdevmode.dmSize = sizeof(gdevmode);
 
     result = ChangeDisplaySettings(&gdevmode, CDS_FULLSCREEN);
-    if (result != DISP_CHANGE_SUCCESSFUL)
-	Sys_Error("Couldn't set fullscreen DIB mode");
+    if (result != DISP_CHANGE_SUCCESSFUL) {
+	/*
+	 * Windows PE's basic display driver can't switch modes. If the mode
+	 * asked for is the desktop's own size, the fullscreen popup simply
+	 * covers the desktop.
+	 */
+	if ((int)mode->width != GetSystemMetrics(SM_CXSCREEN) ||
+	    (int)mode->height != GetSystemMetrics(SM_CYSCREEN))
+	    Sys_Error("Couldn't set fullscreen DIB mode %dx%d (error %ld)",
+		      mode->width, mode->height, result);
+    }
 
     modestate = MS_FULLSCREEN;
     vid_fulldib_on_focus_mode = mode;
